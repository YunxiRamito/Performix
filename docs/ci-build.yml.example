name: build

# Windows-only: the product targets net10.0-windows / net10.0-windows10.0.22621.0 and
# WinUI 3 (Windows App SDK). There is no Linux/macOS build.
#
# SDK: .NET 10 is required — .NET 8/9 SDKs cannot target net10.0-windows.
# The repository does NOT vendor a portable SDK; CI uses the runner's installed one.
# Locally, scripts/*.ps1 read $env:PERFORMIX_DOTNET or <repo>\tools\dotnet-sdk\dotnet.exe.

on:
  push:
    branches: [ main ]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    env:
      DOTNET_CLI_TELEMETRY_OPTOUT: '1'
      DOTNET_NOLOGO: '1'
      DOTNET_SKIP_FIRST_TIME_EXPERIENCE: '1'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Show SDK
        run: dotnet --info

      # One solution build covers Core / Overlay / Probe / Tests / App, plus Legacy.Wpf
      # (the Tests project references the WPF frontend for source-scan and ViewModel tests,
      # so it cannot be skipped).
      - name: Restore
        run: dotnet restore Performix.slnx

      - name: Build solution
        run: dotnet build Performix.slnx -c Release --no-restore

      - name: Test
        run: >
          dotnet test tests/Performix.Tests/Performix.Tests.csproj -c Release --no-build
          --logger "trx;LogFileName=performix-tests.trx"

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: '**/performix-tests.trx'
          if-no-files-found: ignore

      - name: Build WinUI app (x64)
        run: dotnet build src/Performix.App/Performix.App.csproj -p:Platform=x64 -c Release --no-restore
