<?xml version="1.0" encoding="utf-8"?>
<!--
  UpdateInfoWindow — the bottom-right "update status" window.

  WHY A SECOND TOP-LEVEL WINDOW (and not the tray bubble, the shell InfoBar or a ContentDialog):
  the automatic update runs while the shell is hidden to the tray, so a shell-hosted toast would
  have nothing to attach to, a tray bubble needs a balloon/notification channel the unpackaged
  app does not have, and a ContentDialog would be a modal interruption of exactly the kind this
  feature must not create. This window survives the shell hiding, shows progress, and never
  takes focus.

  NOT TOPMOST, ON PURPOSE (the brief): it sits at the bottom-right of the primary work area,
  clear of the taskbar / notification area, and it does NOT float above other applications.
  Anything urgent enough to interrupt belongs on the Update page; this window is the quiet
  status surface. It still refuses activation (WS_EX_NOACTIVATE), so clicking it does not steal
  the caret from whatever the user is typing in.

  STABLE GEOMETRY: the window is exactly the card and its size is fixed (360 × 104 DIP) for
  every state, including "up to date" and "failed". Only the contents swap, so a state change
  never resizes or re-places the window (that was the flicker: one build sized the card to its
  text and the window jumped on every progress line).

  The card is the window (same constraint as ModeOsdWindow: a WinUI 3 top-level window cannot be
  per-pixel transparent, so a larger host would paint an opaque slab around the card).
-->
<Window
    x:Class="Predex.WinUI.Views.UpdateInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Title="PerformixUpdateStatus">

  <Grid x:Name="InfoRoot" Background="Transparent">
    <Border x:Name="Card"
            CornerRadius="8"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            Padding="14,12"
            AutomationProperties.AutomationId="UpdateInfoCard"
            PointerPressed="Card_PointerPressed">

      <Grid RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status line: the state word ("正在下载更新…"), plus the spinner while work is running. -->
        <Grid Grid.Row="0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ProgressRing x:Name="BusyRing" Grid.Column="0"
                        Width="16" Height="16" IsActive="False"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="UpdateInfoBusy"/>
          <TextBlock x:Name="StatusText" Grid.Column="1"
                     FontSize="13" FontWeight="SemiBold"
                     MaxLines="1" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                     AutomationProperties.AutomationId="UpdateInfoStatus"
                     AutomationProperties.LiveSetting="Polite"/>
        </Grid>

        <!-- Detail line: version / bytes / speed, or the failure reason. Two lines, clipped. -->
        <TextBlock x:Name="DetailText" Grid.Row="1"
                   FontSize="11"
                   MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.AutomationId="UpdateInfoDetail"/>

        <!-- Progress: 4 DIP, accent fill. Hidden (not collapsed: the row keeps its height, so the
             card never re-flows between "downloading" and "up to date"). -->
        <Grid Grid.Row="2" ColumnSpacing="8" Height="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="Progress" Grid.Column="0" Height="4" Minimum="0" Maximum="100"
                       CornerRadius="2"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                       Background="{ThemeResource ProgressTrackBrush}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="UpdateInfoProgress"
                       AutomationProperties.Name="Download progress"/>
          <TextBlock x:Name="ProgressText" Grid.Column="1"
                     FontSize="11"
                     Typography.NumeralAlignment="Tabular"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     AutomationProperties.AutomationId="UpdateInfoProgressText"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>

