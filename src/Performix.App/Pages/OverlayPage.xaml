<?xml version="1.0" encoding="utf-8"?>
<!--
  S6 — Overlay page (WinUI 3).

  Port of app\Fork\PreySense.Frontend\Views\MetricsWindow.xaml (WPF) into a page the
  single-window shell hosts. The WPF window is 560 DIP wide with its own title bar; this
  page has 320 DIP and no title bar (the shell draws "浮窗" there), so the same settings
  are laid out as one scrolling column.

  WPF → page mapping (nothing was re-invented):
    Enable Metrics Overlay   → ToggleSwitch          ChkEnableOverlay
    Theme (Dark/White)       → ComboBox              CmbOverlayTheme
    HUD Scale 50–200 %       → Slider + % label      SldHudScale / LabelHudScale
    Background Opacity 0–100 → Slider + % label      SldOpacity / LabelOpacity
    Text Opacity 0–100       → Slider + % label      SldTextOpacity / LabelTextOpacity
    Horizontal / Vertical    → two ComboBoxes        CmbHorizontalPos / CmbVerticalPos
    Show FPS                 → ToggleSwitch          ChkShowFps
    Overlay Metric Slots     → Add button + one block per slot (CPU metric, GPU metric,
                               graph switch, remove)  BtnAddOverlaySlot / slots built in
                               code-behind (SlotsPanel)

  The data lives in PreySense.Core's OverlayConfig (same object the WPF window writes),
  so no ViewModel property is involved — see the note in docs\SHELL-CONTRACT.md §2.
  Writes happen only when the user actually changes a control (same as WPF), and every
  write goes through AppConfig / ConfigurationService, never through a raw JSON edit.

  Layout rules (docs\UI-DESIGN-RULES.md): one column, spacing 4/6/8/12, font sizes
  11/12/16, one border language (CardStyle), rows 30–40 high, right-aligned % labels
  with tabular figures so the numbers do not jitter while dragging.
-->
<Page
    x:Class="Predex.WinUI.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False">

  <Page.Resources>
    <Style x:Key="OverlayRowStyle" TargetType="Grid">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="ColumnSpacing" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="OverlayLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxLines" Value="2"/>
    </Style>

    <!-- Slider / combo rows: the value sits right of the label, 12 SemiBold tabular. -->
    <Style x:Key="OverlayValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="OverlayComboStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OverlaySwitchStyle" TargetType="ToggleSwitch">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="OverlaySliderStyle" TargetType="Slider">
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="OverlayCaptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Stretch">

      <TextBlock Text="{x:Bind local:Loc.T('Overlay HUD: metric slots, scale, opacity, position and theme.')}"
                 Style="{StaticResource PageSubtitleStyle}"
                 AutomationProperties.AutomationId="TxtOverlaySubtitle"/>

      <!-- ═══════════════════════════════════════════════════════════════════
           OVERLAY METRIC SLOTS (first: this is what the page is for)
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="4">
          <Grid>
            <TextBlock Text="{x:Bind local:Loc.T('Overlay Metric Slots')}"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnAddOverlaySlot" Content="{x:Bind local:Loc.T('Add Slot')}"
                    HorizontalAlignment="Right" Height="28" Padding="8,0" FontSize="11"
                    CornerRadius="4"
                    AutomationProperties.AutomationId="BtnAddOverlaySlot"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Add Slot')}"
                    Click="AddSlot_Click"/>
          </Grid>

          <TextBlock x:Name="SlotEmptyHint"
                     Text="{x:Bind local:Loc.T('No overlay slots configured. Click + Add Slot to add metrics.')}"
                     Style="{StaticResource OverlayCaptionStyle}"
                     Margin="0,8,0,8"
                     Visibility="Collapsed"/>

          <StackPanel x:Name="SlotsPanel" Spacing="0" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════════════
           DISPLAY &amp; APPEARANCE (WPF card 1)
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="4">

          <TextBlock Text="{x:Bind local:Loc.T('Display')}"
                     Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>

          <!-- ── Enable Metrics Overlay ────────────────────────────────────── -->
          <Grid Style="{StaticResource OverlayRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Enable Metrics Overlay')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <ToggleSwitch x:Name="ChkEnableOverlay" Grid.Column="1"
                          Style="{StaticResource OverlaySwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          AutomationProperties.AutomationId="ChkEnableOverlay"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Enable Metrics Overlay')}"
                          Toggled="EnableOverlay_Toggled"/>
          </Grid>

          <!-- ── Theme (Dark / White) ──────────────────────────────────────── -->
          <Grid Style="{StaticResource OverlayRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Theme')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <ComboBox x:Name="CmbOverlayTheme" Grid.Column="1"
                      Style="{StaticResource OverlayComboStyle}"
                      AutomationProperties.AutomationId="CmbOverlayTheme"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Theme')}"
                      SelectionChanged="OverlayTheme_SelectionChanged">
              <ComboBoxItem Content="{x:Bind local:Loc.T('Dark')}" Tag="Dark"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('White')}" Tag="White"/>
            </ComboBox>
          </Grid>

          <!-- ── HUD scale 50–200 % (5 % steps) ────────────────────────────── -->
          <StackPanel Margin="0,4,0,0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('HUD Scale')}"
                         Style="{StaticResource OverlayLabelStyle}"/>
              <TextBlock x:Name="LabelHudScale" Grid.Column="1" Text="100%"
                         Style="{StaticResource OverlayValueStyle}"
                         AutomationProperties.AutomationId="LabelHudScale"/>
            </Grid>
            <Slider x:Name="SldHudScale" Style="{StaticResource OverlaySliderStyle}"
                    Minimum="50" Maximum="200" StepFrequency="5"
                    AutomationProperties.AutomationId="SldHudScale"
                    AutomationProperties.Name="{x:Bind local:Loc.T('HUD Scale')}"
                    ValueChanged="HudScale_ValueChanged"/>
          </StackPanel>

          <!-- ── Background opacity 0–100 % (10 % steps) ───────────────────── -->
          <StackPanel Margin="0,4,0,0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Background Opacity')}"
                         Style="{StaticResource OverlayLabelStyle}"/>
              <TextBlock x:Name="LabelOpacity" Grid.Column="1" Text="100%"
                         Style="{StaticResource OverlayValueStyle}"
                         AutomationProperties.AutomationId="LabelOpacity"/>
            </Grid>
            <Slider x:Name="SldOpacity" Style="{StaticResource OverlaySliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="10"
                    AutomationProperties.AutomationId="SldOpacity"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Background Opacity')}"
                    ValueChanged="Opacity_ValueChanged"/>
          </StackPanel>

          <!-- ── Text opacity 0–100 % (10 % steps) ─────────────────────────── -->
          <StackPanel Margin="0,4,0,0">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Text Opacity')}"
                         Style="{StaticResource OverlayLabelStyle}"/>
              <TextBlock x:Name="LabelTextOpacity" Grid.Column="1" Text="100%"
                         Style="{StaticResource OverlayValueStyle}"
                         AutomationProperties.AutomationId="LabelTextOpacity"/>
            </Grid>
            <Slider x:Name="SldTextOpacity" Style="{StaticResource OverlaySliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="10"
                    AutomationProperties.AutomationId="SldTextOpacity"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Text Opacity')}"
                    ValueChanged="TextOpacity_ValueChanged"/>
          </StackPanel>

          <!-- ── Refresh interval (read-only) ────────────────────────────────
               The WPF MetricsWindow has no refresh-interval control and OverlayConfig has
               no such field: the overlay is repainted from PreySense.Core's
               TelemetryCoordinator, whose master timer is fixed at 1 s (see
               TelemetryCoordinator.cs: MasterTimer = new(1000), MinDemandPollIntervalSeconds
               = 1.0). Showing the real value read-only is honest; a slider here would write
               a setting that nothing reads. Both Core and the Overlay project are outside
               this stage's write scope. -->
          <Grid Style="{StaticResource OverlayRowStyle}" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Refresh interval')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind local:Loc.T('1 s (fixed)')}"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       ToolTipService.ToolTip="{x:Bind local:Loc.T('Fixed by the telemetry coordinator: the overlay samples once per second.')}"
                       AutomationProperties.AutomationId="TxtOverlayRefresh"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════════════
           POSITION (WPF card 1, second half)
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="4">

          <TextBlock Text="{x:Bind local:Loc.T('Position')}"
                     Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>

          <Grid Style="{StaticResource OverlayRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Horizontal Position')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <ComboBox x:Name="CmbHorizontalPos" Grid.Column="1"
                      Style="{StaticResource OverlayComboStyle}"
                      AutomationProperties.AutomationId="CmbHorizontalPos"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Horizontal Position')}"
                      SelectionChanged="Position_SelectionChanged">
              <ComboBoxItem Content="{x:Bind local:Loc.T('Left')}" Tag="Left"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Center')}" Tag="Center"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Right')}" Tag="Right"/>
            </ComboBox>
          </Grid>

          <Grid Style="{StaticResource OverlayRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Vertical Position')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <ComboBox x:Name="CmbVerticalPos" Grid.Column="1"
                      Style="{StaticResource OverlayComboStyle}"
                      AutomationProperties.AutomationId="CmbVerticalPos"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Vertical Position')}"
                      SelectionChanged="Position_SelectionChanged">
              <ComboBoxItem Content="{x:Bind local:Loc.T('Top')}" Tag="Top"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Center')}" Tag="Center"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Bottom')}" Tag="Bottom"/>
            </ComboBox>
          </Grid>

          <Grid Style="{StaticResource OverlayRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Show FPS')}"
                       Style="{StaticResource OverlayLabelStyle}"/>
            <ToggleSwitch x:Name="ChkShowFps" Grid.Column="1"
                          Style="{StaticResource OverlaySwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          AutomationProperties.AutomationId="ChkShowFps"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Show FPS')}"
                          Toggled="ShowFps_Toggled"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Inline error line (a failed config write must not open a dialog from a page). -->
      <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#FFFF6B6B"
                 TextWrapping="Wrap" Visibility="Collapsed"
                 AutomationProperties.AutomationId="TxtOverlayError"/>
    </StackPanel>
  </ScrollViewer>
</Page>
