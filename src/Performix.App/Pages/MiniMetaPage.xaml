<?xml version="1.0" encoding="utf-8"?>
<!--
  Updates and About — settings sub-page (IA phase 1, docs\design\UI-ARCH.md §1/§2).

  One page for the two read-only settings areas the design groups together:

    Update   current state of the update feed + the check button. There is no release feed
             yet (UpdateCheckService.UpdateFeedConfigured = false), so the page says exactly
             that: the status line reads "Not configured", a sentence explains why, and the
             check button is disabled. No fake progress bar, no invented "up to date".
    About    version, build time, architecture, an "Open logs folder" button (shell.log /
             crash.log live next to the executable) and the GPL-3.0 licence line that points
             at THIRD-PARTY-NOTICES.md.

  Facts come from Services\AboutInfo (assembly metadata + runtime), never from a hard-coded
  string; the licence text is the only static copy and it lives in UiText through Loc.T().
  Styles/tokens come from Styles\Resources.xaml; layout follows the two page-level cards.
-->
<Page
    x:Class="Predex.WinUI.Pages.MiniMetaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PageMeta"
    AutomationProperties.Name="{x:Bind local:Loc.T('Updates and About')}">

  <Page.Resources>
    <!-- Read-only value column (right-aligned, tabular): one style for every fact row. -->
    <Style x:Key="MetaValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Muted variant for a state instead of a fact ("Not configured"). -->
    <Style x:Key="MetaStateStyle" TargetType="TextBlock" BasedOn="{StaticResource MetaValueStyle}">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">

      <TextBlock Text="{x:Bind local:Loc.T('Version, update state, build and licence.')}"
                 Style="{StaticResource PageSubtitleStyle}"
                 AutomationProperties.AutomationId="TxtMetaSubtitle"/>

      <!-- ═══════════════════════════════════════════════════════════════════
           UPDATE (honest placeholder — the feed does not exist yet)
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <TextBlock Text="{x:Bind local:Loc.T('Update')}"
                     Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Update feed')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind UpdateStateText}"
                       Style="{StaticResource MetaStateStyle}"
                       AutomationProperties.AutomationId="TxtUpdateState"/>
          </Grid>

          <TextBlock Text="{x:Bind UpdateExplanationText}"
                     Style="{StaticResource SettingHintStyle}"
                     Margin="0,0,0,8"
                     AutomationProperties.AutomationId="TxtUpdateExplanation"/>

          <!-- Disabled while UpdateCheckService.IsUpdateFeedConfigured == false; the tooltip
               says why instead of letting the click do nothing. Both the state text and this
               switch are bound to the flag, so the page cannot claim a feed that does not
               exist (no fake progress, no invented "up to date"). -->
          <Button Content="{x:Bind local:Loc.T('Check for updates')}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  IsEnabled="{x:Bind IsUpdateFeedConfigured}"
                  Click="CheckUpdates_Click"
                  AutomationProperties.AutomationId="BtnCheckUpdates"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Check for updates')}"
                  ToolTipService.ToolTip="{x:Bind UpdateButtonHint}"/>
        </StackPanel>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════════════
           ABOUT (version / build / arch / logs / licence)
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <TextBlock Text="{x:Bind local:Loc.T('About')}"
                     Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Version')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind VersionText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtMetaVersion"/>
          </Grid>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Build time')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind BuildTimeText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtMetaBuildTime"/>
          </Grid>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Architecture')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ArchitectureText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtMetaArchitecture"/>
          </Grid>

          <Button Content="{x:Bind local:Loc.T('Open logs folder')}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,8,0,0"
                  Click="OpenLogsFolder_Click"
                  AutomationProperties.AutomationId="BtnOpenLogs"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Open logs folder')}"
                  ToolTipService.ToolTip="{x:Bind LogsFolderPath}"/>

          <TextBlock Text="{x:Bind local:Loc.T('Logs and crash reports live next to the executable (shell.log, crash.log).')}"
                     Style="{StaticResource SettingHintStyle}"
                     Margin="0,6,0,0"
                     AutomationProperties.AutomationId="TxtLogsHint"/>

          <TextBlock Text="{x:Bind local:Loc.T('GPL-3.0. Performix is free software; third-party components are listed in THIRD-PARTY-NOTICES.md.')}"
                     Style="{StaticResource SettingHintStyle}"
                     Margin="0,12,0,0"
                     AutomationProperties.AutomationId="TxtLicense"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
