<?xml version="1.0" encoding="utf-8"?>
<!--
  Tuning page (S3). WPF source: Views\ModeSettingsWindow.xaml (380 lines) + its 961-line
  code-behind. Section order follows the WPF page and docs\UI-REDESIGN.md:

    status bar (read only)  ->  performance mode row  ->  CPU scheduling  ->  GPU overclocking
    -> fans entry  ->  Advanced expander (collapsed by default)

  Rules applied (docs\UI-DESIGN-RULES.md + docs\UI-REDESIGN.md §硬性视觉规则):
    * one border language: cards (radius 6, 1 px, padding 12); spacing 4/6/8/12 only
    * font sizes 11 (label) / 12 (section title) / 14 (live value) / 16 (page title)
    * slider + NumberBox are paired on one draft value, so dragging echoes instantly;
      nothing is applied on release - each block owns its own Apply button
    * a long explanation never sits in the body: it becomes a "?" dot right of the title
    * capabilities that need the kernel driver stay VISIBLE but disabled, with a tooltip
      explaining why (CPU undervolt / PL1-PL2 / PROCHOT / GPU power limits)
    * number boxes: fixed 72 width, right-of-row, Consolas (fixed-width digits) + tabular
      figures on every read-only number

  Localization: every literal goes through local:Loc.T (LocalizationService / UiText), the
  English source text is what is written here (red line 7); strings containing an apostrophe
  are page properties in the code-behind because x:Bind string literals cannot carry one.

  Bindings: "Vm.*" is MainViewModel (assigned by the shell, contract in TuningPage.xaml.cs);
  unqualified names are page-local draft properties of this page.
-->
<Page
    x:Class="Predex.WinUI.Pages.TuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    xmlns:controls="using:Predex.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False">

  <Page.Resources>

    <!-- Card / section title / mode tile all come from Styles\Resources.xaml (CardStyle,
         SectionTitleStyle, ModeTileButtonStyle). This page used to carry private copies with
         a brighter title colour and a horizontal chip mode selector — that is what made
         tuning look like a different app than home (R2 items 2 and 6). -->

    <!-- ═══ TEXT ═══ -->
    <Style x:Key="TuningRowLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxLines" Value="2"/>
    </Style>

    <Style x:Key="TuningHeroValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="TuningStatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <!-- ═══ "?" hint dot: replaces a long explanatory sentence (UI-REDESIGN rule 6) ═══ -->
    <Style x:Key="TuningHelpDotStyle" TargetType="Border">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TuningHelpDotTextStyle" TargetType="TextBlock">
      <Setter Property="Text" Value="?"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="LineHeight" Value="15"/>
    </Style>

    <!-- ═══ ROW CONTROLS ═══ -->
    <Style x:Key="TuningSliderStyle" TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="60"/>
    </Style>

    <!-- Fixed 72 width (UI-REDESIGN), UI font with tabular figures (T8), invalid input clamped back -->
    <Style x:Key="TuningValueBoxStyle" TargetType="NumberBox">
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
      <Setter Property="ValidationMode" Value="InvalidInputOverwritten"/>
    </Style>

    <Style x:Key="TuningComboStyle" TargetType="ComboBox">
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
      <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
      <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ BUTTONS ═══ -->
    <Style x:Key="TuningApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TuningSubtleButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Destructive / restore actions get their own style (UI-REDESIGN rule 5) -->
    <Style x:Key="TuningDividerStyle" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

  </Page.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                Padding="12,10,12,12">
    <StackPanel Spacing="12">

      <!-- ══════════════════════════════════════════════════════════════
           0. PAGE SUBTITLE
           The shell title bar already says "调校"; a second 16 DIP heading on the page
           repeated it and ate window budget on a 280 DIP window. Pages show one 11 DIP
           subtitle line and nothing else (R2 item 2 of the second review).
           ══════════════════════════════════════════════════════════════ -->
      <TextBlock Text="{x:Bind PageSubtitle}" Style="{StaticResource PageSubtitleStyle}"
                 AutomationProperties.AutomationId="TxtTuningSubtitle"/>

      <!-- ══════════════════════════════════════════════════════════════
           1. LIVE STATUS BAR (read only, pipe telemetry)
           Two rows × two columns: four equal columns only leave ~62 DIP per cell inside
           a 12 DIP card at 320 DIP window width, which cut "4109 RPM" off at the card
           edge (R2 item 1). The value is 14 SemiBold tabular, the unit is a separate
           11 Regular Muted run 4 DIP away, per UI-DESIGN-RULES §3.3.
           ══════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}"
              AutomationProperties.AutomationId="TuningStatusBar">
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- CPU temperature -->
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
            <TextBlock Text="{x:Bind local:Loc.T('CPU')}" Style="{StaticResource CaptionTextStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind controls:TelemetryText.Value(Vm.CpuTemperatureText), Mode=OneWay}"
                         Style="{StaticResource TuningHeroValueStyle}"
                         AutomationProperties.AutomationId="StatusCpuTemp"
                         AutomationProperties.Name="{x:Bind local:Loc.T('CPU temperature')}"/>
              <TextBlock Text="{x:Bind controls:TelemetryText.Unit(Vm.CpuTemperatureText), Mode=OneWay}"
                         Style="{StaticResource UnitTextStyle}"/>
            </StackPanel>
          </StackPanel>

          <!-- GPU temperature -->
          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
            <TextBlock Text="{x:Bind local:Loc.T('GPU')}" Style="{StaticResource CaptionTextStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind controls:TelemetryText.Value(Vm.GpuTemperatureText), Mode=OneWay}"
                         Style="{StaticResource TuningHeroValueStyle}"
                         AutomationProperties.AutomationId="StatusGpuTemp"
                         AutomationProperties.Name="{x:Bind local:Loc.T('GPU temperature')}"/>
              <TextBlock Text="{x:Bind controls:TelemetryText.Unit(Vm.GpuTemperatureText), Mode=OneWay}"
                         Style="{StaticResource UnitTextStyle}"/>
            </StackPanel>
          </StackPanel>

          <!-- CPU fan -->
          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
            <TextBlock Text="{x:Bind local:Loc.T('CPU Fan')}" Style="{StaticResource CaptionTextStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind controls:TelemetryText.Value(Vm.CpuFanText), Mode=OneWay}"
                         Style="{StaticResource TuningHeroValueStyle}"
                         AutomationProperties.AutomationId="StatusCpuFan"
                         AutomationProperties.Name="{x:Bind local:Loc.T('CPU fan speed')}"/>
              <TextBlock Text="{x:Bind controls:TelemetryText.Unit(Vm.CpuFanText), Mode=OneWay}"
                         Style="{StaticResource UnitTextStyle}"/>
            </StackPanel>
          </StackPanel>

          <!-- GPU fan -->
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
            <TextBlock Text="{x:Bind local:Loc.T('GPU Fan')}" Style="{StaticResource CaptionTextStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind controls:TelemetryText.Value(Vm.GpuFanText), Mode=OneWay}"
                         Style="{StaticResource TuningHeroValueStyle}"
                         AutomationProperties.AutomationId="StatusGpuFan"
                         AutomationProperties.Name="{x:Bind local:Loc.T('GPU fan speed')}"/>
              <TextBlock Text="{x:Bind controls:TelemetryText.Unit(Vm.GpuFanText), Mode=OneWay}"
                         Style="{StaticResource UnitTextStyle}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           2. PERFORMANCE MODE - the SAME control as the home page row
           It used to be five horizontal text chips with no idle surface (so nothing
           looked clickable), each with its own rainbow selected outline, and the header
           repeated the active mode name on the right. Now: ModeTileButtonStyle tiles,
           icon above label, one selected state (#263B82F6 fill + #3B82F6 outline), and no
           duplicated value in the header — the selected tile already says it (R2 item 4).
           ══════════════════════════════════════════════════════════════ -->
      <StackPanel Spacing="6">
<Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Performance Mode')}"
                       Style="{StaticResource SectionTitleStyle}"/>
            <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="12"
                      Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Margin="2,0,0,0"
                    ToolTipService.ToolTip="{x:Bind ModeSwitchTooltip}"
                    AutomationProperties.AutomationId="HintPerformanceMode"/>
          </Grid>
<Grid ColumnSpacing="{StaticResource GapTight}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsEcoActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Command="{x:Bind Vm.SetModeCommand}" CommandParameter="6"
                    AutomationProperties.AutomationId="BtnModeEco"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Eco')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Eco')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <FontIcon Style="{x:Bind local:Converters.BoolToStyle(Vm.IsEcoActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE8BE;"/>
                <TextBlock Text="{x:Bind local:Loc.T('Eco')}" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsEcoActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsQuietActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Command="{x:Bind Vm.SetModeCommand}" CommandParameter="0"
                    AutomationProperties.AutomationId="BtnModeQuiet"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Quiet')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Quiet')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <FontIcon Style="{x:Bind local:Converters.BoolToStyle(Vm.IsQuietActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE708;"/>
                <TextBlock Text="{x:Bind local:Loc.T('Quiet')}" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsQuietActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsBalancedActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Command="{x:Bind Vm.SetModeCommand}" CommandParameter="1"
                    AutomationProperties.AutomationId="BtnModeBalanced"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Balanced')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Balanced')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <FontIcon Style="{x:Bind local:Converters.BoolToStyle(Vm.IsBalancedActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE9E9;"/>
                <TextBlock Text="{x:Bind local:Loc.T('Bal')}" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsBalancedActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="3" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsPerformActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Command="{x:Bind Vm.SetModeCommand}" CommandParameter="4"
                    AutomationProperties.AutomationId="BtnModePerformance"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Performance')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Performance')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <FontIcon Style="{x:Bind local:Converters.BoolToStyle(Vm.IsPerformActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xEC4A;"/>
                <TextBlock Text="{x:Bind local:Loc.T('Perf')}" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsPerformActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="4" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsTurboActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Command="{x:Bind Vm.SetModeCommand}" CommandParameter="5"
                    AutomationProperties.AutomationId="BtnModeTurbo"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Beast')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Beast')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <FontIcon Style="{x:Bind local:Converters.BoolToStyle(Vm.IsTurboActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE945;"/>
                <TextBlock Text="{x:Bind local:Loc.T('Beast')}" Style="{x:Bind local:Converters.BoolToStyle(Vm.IsTurboActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
              </StackPanel>
            </Button>
          </Grid>
      </StackPanel>

      <!-- ══════════════════════════════════════════════════════════════
           3. CPU SCHEDULING (Windows power scheme / SUB_PROCESSOR, no driver needed)
           ══════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">

          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('CPU Scheduling')}"
                       Style="{StaticResource SectionTitleStyle}"/>
            <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="12"
                      Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Margin="2,0,0,0"
                    ToolTipService.ToolTip="{x:Bind CpuSchedulingTooltip}"
                    AutomationProperties.AutomationId="HintCpuScheduling"/>
          </Grid>

          <!-- Power source: the schedule is per AC / DC side -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Power source')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource TuningComboStyle}"
                      HorizontalAlignment="Stretch" MinWidth="96"
                      SelectedIndex="{x:Bind CpuPowerSourceIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="CmbCpuPowerSource"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Power source')}">
              <ComboBoxItem Content="{x:Bind local:Loc.T('AC')}"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('DC')}"/>
            </ComboBox>
          </Grid>

          <!-- Max processor state -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Max processor state (%)')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind CpuMaxState, Mode=TwoWay}"
                    AutomationProperties.AutomationId="SldCpuMaxState"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Max processor state')}"/>
            <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                       Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                       Value="{x:Bind CpuMaxState, Mode=TwoWay}"
                       AutomationProperties.AutomationId="TxtCpuMaxState"
                       AutomationProperties.Name="{x:Bind local:Loc.T('Max processor state value')}"/>
          </Grid>

          <!-- Boost mode (PERFBOOSTMODE 0..6) -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Boost Mode')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <ComboBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource TuningComboStyle}"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind BoostModeNames}"
                      SelectedIndex="{x:Bind CpuBoostIndex, Mode=TwoWay}"
                      AutomationProperties.AutomationId="CmbBoostMode"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Boost Mode')}"/>
          </Grid>

          <!-- EPP -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('EPP preference')}"
                       Style="{StaticResource TuningRowLabelStyle}"
                       ToolTipService.ToolTip="{x:Bind local:Loc.T('EPP preference (0 perf - 100 power)')}"/>
            <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind CpuEpp, Mode=TwoWay}"
                    AutomationProperties.AutomationId="SldCpuEpp"
                    AutomationProperties.Name="{x:Bind local:Loc.T('EPP preference')}"/>
            <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                       Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                       Value="{x:Bind CpuEpp, Mode=TwoWay}"
                       AutomationProperties.AutomationId="TxtCpuEpp"
                       AutomationProperties.Name="{x:Bind local:Loc.T('EPP preference value')}"/>
          </Grid>

          <!-- Core parking min -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Core parking min (%)')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind CpuCoreParkMin, Mode=TwoWay}"
                    AutomationProperties.AutomationId="SldCpuCoreMin"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Core parking minimum')}"/>
            <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                       Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                       Value="{x:Bind CpuCoreParkMin, Mode=TwoWay}"
                       AutomationProperties.AutomationId="TxtCpuCoreMin"
                       AutomationProperties.Name="{x:Bind local:Loc.T('Core parking minimum value')}"/>
          </Grid>

          <!-- Core parking max -->
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Core parking max (%)')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind CpuCoreParkMax, Mode=TwoWay}"
                    AutomationProperties.AutomationId="SldCpuCoreMax"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Core parking maximum')}"/>
            <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                       Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                       Value="{x:Bind CpuCoreParkMax, Mode=TwoWay}"
                       AutomationProperties.AutomationId="TxtCpuCoreMax"
                       AutomationProperties.Name="{x:Bind local:Loc.T('Core parking maximum value')}"/>
          </Grid>

          <!-- This block owns its Apply (nothing is applied on slider release) -->
          <Grid ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource TuningApplyButtonStyle}"
                    Click="ApplyCpuSchedule_Click"
                    AutomationProperties.AutomationId="BtnApplyCpuSchedule"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Apply to Current Mode')}"
                    Content="{x:Bind local:Loc.T('Apply to Current Mode')}"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                    Click="ResetCpuSchedule_Click"
                    AutomationProperties.AutomationId="BtnResetCpuSchedule"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Restore Windows Defaults')}"
                    Content="{x:Bind local:Loc.T('Restore Windows Defaults')}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           4. GPU OVERCLOCKING (NVAPI clock offsets - works without the driver)
           ══════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">

          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('GPU Overclocking')}"
                       Style="{StaticResource SectionTitleStyle}"/>
            <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="12"
                      Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Margin="2,0,0,0"
                    ToolTipService.ToolTip="{x:Bind GpuOverclockTooltip}"
                    AutomationProperties.AutomationId="HintGpuOverclocking"/>
            <ToggleSwitch Grid.Column="2" OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          MinWidth="0" Margin="0"
                          IsOn="{x:Bind GpuOverclockEnabled, Mode=TwoWay}"
                          IsEnabled="{x:Bind Vm.IsGpuClockTuningAvailable, Mode=OneWay}"
                          AutomationProperties.AutomationId="ChkEnableGpuOverclocking"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Apply GPU clock offsets')}"
                          ToolTipService.ToolTip="{x:Bind local:Loc.T('Apply GPU clock offsets')}"/>
          </Grid>

          <!-- Unsupported GPU / driver: the block stays visible and says why -->
          <TextBlock Text="{x:Bind Vm.GpuClockTuningUnavailableReason, Mode=OneWay}"
                     Style="{StaticResource TuningRowLabelStyle}"
                     Visibility="{x:Bind local:Converters.InvertBoolToVis(Vm.IsGpuClockTuningAvailable), Mode=OneWay}"
                     AutomationProperties.AutomationId="TxtGpuClockUnavailable"/>

          <!-- Disabling a group needs a Control: StackPanel/Grid have no IsEnabled in WinUI 3,
               and a non-Control element carrying IsEnabled makes the XAML compiler fail
               (silently, exit 1) instead of reporting the unknown member. -->
          <ContentControl IsEnabled="{x:Bind GpuChildrenEnabled, Mode=OneWay}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <StackPanel Spacing="8">

            <!-- Core clock offset -->
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Core clock offset (MHz)')}"
                         Style="{StaticResource TuningRowLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="SldGpuCore" Style="{StaticResource TuningSliderStyle}"
                      Minimum="0" Maximum="500" StepFrequency="5"
                      Value="{x:Bind GpuCoreOffset, Mode=TwoWay}"
                      AutomationProperties.AutomationId="GpuCoreClockOffset"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Core clock offset')}"/>
              <NumberBox Grid.Column="2" x:Name="BoxGpuCore" Style="{StaticResource TuningValueBoxStyle}"
                         Minimum="0" Maximum="500" SmallChange="5" LargeChange="5"
                         Value="{x:Bind GpuCoreOffset, Mode=TwoWay}"
                         AutomationProperties.AutomationId="TxtGpuCoreClockOffset"
                         AutomationProperties.Name="{x:Bind local:Loc.T('Core clock offset value')}"/>
            </Grid>

            <!-- Memory clock offset -->
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Memory clock offset (MHz)')}"
                         Style="{StaticResource TuningRowLabelStyle}"/>
              <Slider Grid.Column="1" x:Name="SldGpuMemory" Style="{StaticResource TuningSliderStyle}"
                      Minimum="0" Maximum="1000" StepFrequency="100"
                      Value="{x:Bind GpuMemoryOffset, Mode=TwoWay}"
                      AutomationProperties.AutomationId="GpuMemoryClockOffset"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Memory clock offset')}"/>
              <NumberBox Grid.Column="2" x:Name="BoxGpuMemory" Style="{StaticResource TuningValueBoxStyle}"
                         Minimum="0" Maximum="1000" SmallChange="100" LargeChange="100"
                         Value="{x:Bind GpuMemoryOffset, Mode=TwoWay}"
                         AutomationProperties.AutomationId="TxtGpuMemoryClockOffset"
                         AutomationProperties.Name="{x:Bind local:Loc.T('Memory clock offset value')}"/>
            </Grid>
          </StackPanel>
          </ContentControl>

          <Grid ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource TuningApplyButtonStyle}"
                    IsEnabled="{x:Bind GpuChildrenEnabled, Mode=OneWay}"
                    Click="ApplyGpuClock_Click"
                    AutomationProperties.AutomationId="BtnApplyGpuClock"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Apply GPU clock offsets')}"
                    Content="{x:Bind local:Loc.T('Apply')}"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{x:Bind GpuChildrenEnabled, Mode=OneWay}"
                    Click="ResetGpuClock_Click"
                    AutomationProperties.AutomationId="BtnResetGpuClockOffsets"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Restore Default 0/0 MHz')}"
                    Content="{x:Bind local:Loc.T('Restore Default 0/0 MHz')}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           5. FANS ENTRY
           ══════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">

          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Fans')}"
                       Style="{StaticResource SectionTitleStyle}"/>
            <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="12"
                      Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Margin="2,0,0,0"
                    ToolTipService.ToolTip="{x:Bind FanPolicyTooltip}"
                    AutomationProperties.AutomationId="HintFanPolicy"/>
          </Grid>

          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Fan Policy')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind FanPolicyText}" Style="{StaticResource StatusTextStyle}"
                       AutomationProperties.AutomationId="TxtFanPolicy"/>
          </Grid>

          <Button Style="{StaticResource TuningSubtleButtonStyle}" Margin="0,4,0,0"
                  Click="OpenFanEditor_Click"
                  AutomationProperties.AutomationId="BtnOpenFanCurve"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Open Curve Editor')}"
                  Content="{x:Bind local:Loc.T('Open Curve Editor')}"/>
        </StackPanel>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           6. ADVANCED (collapsed by default; driver-backed sections, greyed not hidden)
           ══════════════════════════════════════════════════════════════ -->
      <Expander x:Name="AdvancedExpander" IsExpanded="False"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Header="{x:Bind local:Loc.T('Advanced')}"
                AutomationProperties.AutomationId="ExpAdvanced">
        <StackPanel Spacing="8" Padding="0,8,0,0">

          <InfoBar Severity="Informational" IsClosable="False"
                   IsOpen="True"
                   Title="{x:Bind local:Loc.T('Kernel driver required')}"
                   Message="{x:Bind DriverNoticeText}"
                   AutomationProperties.AutomationId="InfoAdvancedDriverNotice"/>

          <!-- Enable tuning (the driver switch that gates everything else) -->
          <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind HardwareTuningTooltip}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Enable tuning')}"
                       Style="{StaticResource TuningRowLabelStyle}"/>
            <ToggleSwitch Grid.Column="1" MinWidth="0" Margin="0"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          IsOn="{x:Bind Vm.IsHardwareTuningEnabled, Mode=TwoWay}"
                          IsEnabled="{x:Bind Vm.IsKernelDriverSupported, Mode=OneWay}"
                          AutomationProperties.AutomationId="ChkEnableTuning"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Enable tuning')}"/>
          </Grid>

          <Border Style="{StaticResource TuningDividerStyle}"/>

          <!-- CPU boost mode (driver) -->
          <StackPanel Spacing="6" ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}">
            <TextBlock Text="{x:Bind local:Loc.T('CPU boost (driver)')}" Style="{StaticResource TuningRowLabelStyle}"/>
            <ComboBox Style="{StaticResource TuningComboStyle}" HorizontalAlignment="Stretch"
                      IsEnabled="False"
                      ItemsSource="{x:Bind BoostModeNames}"
                      SelectedIndex="{x:Bind Vm.CpuBoostMode, Mode=OneWay}"
                      AutomationProperties.AutomationId="CmbTuningCpuBoost"
                      AutomationProperties.Name="{x:Bind local:Loc.T('CPU boost mode')}"/>
          </StackPanel>

          <!-- CPU power limits: PL1 / PL2 / Tau -->
          <StackPanel Spacing="6" ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}">
            <TextBlock Text="{x:Bind local:Loc.T('CPU power limits')}" Style="{StaticResource TuningRowLabelStyle}"/>
            <ContentControl IsEnabled="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <StackPanel Spacing="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Sustained PL1 (W)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="5" Maximum="300" StepFrequency="5"
                        Value="{x:Bind Pl1Value, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldPl1"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="5" Maximum="300" SmallChange="5" LargeChange="5"
                           Value="{x:Bind Pl1Value, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtPl1"
                           AutomationProperties.Name="{x:Bind local:Loc.T('Sustained long power PL1')}"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Burst PL2 (W)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="5" Maximum="300" StepFrequency="5"
                        Value="{x:Bind Pl2Value, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldPl2"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="5" Maximum="300" SmallChange="5" LargeChange="5"
                           Value="{x:Bind Pl2Value, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtPl2"
                           AutomationProperties.Name="{x:Bind local:Loc.T('Burst peak power PL2')}"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Turbo time limit Tau (s)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="0" Maximum="11" StepFrequency="1"
                        Value="{x:Bind TauValue, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldTau"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="0" Maximum="11" SmallChange="1" LargeChange="1"
                           Value="{x:Bind TauValue, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtTau"
                           AutomationProperties.Name="{x:Bind local:Loc.T('Turbo time limit')}"/>
              </Grid>
            </StackPanel>
            </ContentControl>
          </StackPanel>

          <!-- CPU undervolt: no driver, no MSR access -->
          <StackPanel Spacing="6" ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}">
            <TextBlock Text="{x:Bind local:Loc.T('CPU undervolt (mV)')}" Style="{StaticResource TuningRowLabelStyle}"/>
            <ContentControl IsEnabled="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                      Minimum="0" Maximum="150" StepFrequency="5"
                      AutomationProperties.AutomationId="SldCpuUndervolt"/>
              <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                         Minimum="0" Maximum="150" SmallChange="5" LargeChange="5" Value="0"
                         AutomationProperties.AutomationId="TxtCpuUndervolt"
                         AutomationProperties.Name="{x:Bind local:Loc.T('CPU undervolt')}"/>
            </Grid>
            </ContentControl>
          </StackPanel>

          <!-- PROCHOT offset -->
          <StackPanel Spacing="6">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('PROCHOT offset (C)')}"
                         Style="{StaticResource TuningRowLabelStyle}"/>
              <TextBlock Grid.Column="1" Text="{x:Bind Vm.ProchotActivationLabel, Mode=OneWay}"
                         Style="{StaticResource StatusTextStyle}"
                         AutomationProperties.AutomationId="TxtProchotActivation"/>
              <ToggleSwitch Grid.Column="2" MinWidth="0" Margin="0"
                            OnContent="{x:Bind local:Loc.T('On')}"
                            OffContent="{x:Bind local:Loc.T('Off')}"
                            IsOn="{x:Bind Vm.IsProchotOffsetEnabled, Mode=TwoWay}"
                            IsEnabled="{x:Bind Vm.CanToggleProchotOffset, Mode=OneWay}"
                            AutomationProperties.AutomationId="ChkEnableGlobalProchotOffset"
                            AutomationProperties.Name="{x:Bind local:Loc.T('PROCHOT offset')}"/>
            </Grid>
            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="72"/>
              </Grid.ColumnDefinitions>
              <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                      Minimum="0" Maximum="63" StepFrequency="1"
                      Value="{x:Bind ProchotOffsetValue, Mode=TwoWay}"
                      IsEnabled="{x:Bind Vm.CanEditProchotOffset, Mode=OneWay}"
                      AutomationProperties.AutomationId="SldProchotOffset"/>
              <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                         Minimum="0" Maximum="63" SmallChange="1" LargeChange="1"
                         Value="{x:Bind ProchotOffsetValue, Mode=TwoWay}"
                         IsEnabled="{x:Bind Vm.CanEditProchotOffset, Mode=OneWay}"
                         AutomationProperties.AutomationId="TxtProchotOffset"
                         AutomationProperties.Name="{x:Bind local:Loc.T('CPU PROCHOT offset')}"/>
            </Grid>
          </StackPanel>

          <!-- GPU power limits (ERM4 offsets) -->
          <StackPanel Spacing="6" ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}">
            <TextBlock Text="{x:Bind local:Loc.T('GPU power limits')}" Style="{StaticResource TuningRowLabelStyle}"/>
            <ContentControl IsEnabled="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <StackPanel Spacing="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Power limit (W)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="0" Maximum="255" StepFrequency="5"
                        Value="{x:Bind GpuDeltaValue, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldGpuDelta"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="0" Maximum="255" SmallChange="5" LargeChange="5"
                           Value="{x:Bind GpuDeltaValue, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtGpuPowerLimit"
                           AutomationProperties.Name="{x:Bind local:Loc.T('GPU power limit')}"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Dynamic Boost (W)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="0" Maximum="25" StepFrequency="5"
                        Value="{x:Bind GpuDynamicBoostValue, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldGpuDynamicBoost"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="0" Maximum="25" SmallChange="5" LargeChange="5"
                           Value="{x:Bind GpuDynamicBoostValue, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtGpuDynamicBoost"
                           AutomationProperties.Name="{x:Bind local:Loc.T('GPU dynamic boost')}"/>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Platform offset (W)')}"
                           Style="{StaticResource TuningRowLabelStyle}"/>
                <Slider Grid.Column="1" Style="{StaticResource TuningSliderStyle}"
                        Minimum="0" Maximum="100" StepFrequency="5"
                        Value="{x:Bind GpuPlatformOffsetValue, Mode=TwoWay}"
                        AutomationProperties.AutomationId="SldPlatformPowerOffset"/>
                <NumberBox Grid.Column="2" Style="{StaticResource TuningValueBoxStyle}"
                           Minimum="0" Maximum="100" SmallChange="5" LargeChange="5"
                           Value="{x:Bind GpuPlatformOffsetValue, Mode=TwoWay}"
                           AutomationProperties.AutomationId="TxtPlatformPowerOffset"
                           AutomationProperties.Name="{x:Bind local:Loc.T('Platform power limit offset')}"/>
              </Grid>
            </StackPanel>
            </ContentControl>
          </StackPanel>

          <!-- Greyed, not hidden: the block is visible so the user sees why it is off -->
          <Button Style="{StaticResource TuningApplyButtonStyle}" Margin="0,4,0,0"
                  IsEnabled="{x:Bind Vm.IsKernelDriverSupported, Mode=OneWay}"
                  Click="ApplyAdvanced_Click"
                  ToolTipService.ToolTip="{x:Bind DriverLockedTooltip}"
                  AutomationProperties.AutomationId="BtnApplyAdvancedTuning"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Apply driver tuning')}"
                  Content="{x:Bind local:Loc.T('Apply driver tuning')}"/>
        </StackPanel>
      </Expander>

      <!-- ══════════════════════════════════════════════════════════════
           Result line (what the last Apply / Reset reported)
           ══════════════════════════════════════════════════════════════ -->
      <TextBlock x:Name="StatusText" Style="{StaticResource TuningStatusTextStyle}"
                 AutomationProperties.AutomationId="TuningStatusText"
                 AutomationProperties.LiveSetting="Polite"/>

    </StackPanel>
  </ScrollViewer>
</Page>
