<?xml version="1.0" encoding="utf-8"?>
<!--
  About — settings sub-page (settings IA v2). Split out of the old "Updates and About" page so the
  directory can offer the two facts separately.

  Facts only, from Services\AboutInfo and the live runtime:
    Version       the assembly's InformationalVersion, e.g. v0.1.0-alpha.1 (the same string the
                  Settings header shows)
    Build time    last-write timestamp of the running Performix.exe
    Architecture  process · OS, and only the pair when the process runs emulated
    Licence       GPL-3.0 + the third-party notice file
    Repository    the project page, opened through HyperlinkButton.NavigateUri
    Logs folder   the directory shell.log / crash.log actually live in (kept from the old page:
                  this was a working entry point and removing it would be a regression)

  No hardware access, no network call: a metadata read and two shell launches.
  Styles: MetaValueStyle is the same right-aligned tabular value column the Update card uses.
-->
<Page
    x:Class="Predex.WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PageAbout"
    AutomationProperties.Name="{x:Bind local:Loc.T('About')}">

  <Page.Resources>
    <Style x:Key="MetaValueStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
      <Setter Property="Foreground" Value="{ThemeResource PageTextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <TextBlock Text="{x:Bind local:Loc.T('About')}"
                     Style="{StaticResource SectionTitleStyle}"
                     Margin="0,0,0,4"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Version')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind VersionText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtAboutVersion"/>
          </Grid>

          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Build time')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind BuildTimeText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtAboutBuildTime"/>
          </Grid>

          <!-- Only the OS architecture when the process matches it: "X64 · X64" said the same
               thing twice. The pair is shown only when the process runs emulated. -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Architecture')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ArchitectureText}"
                       Style="{StaticResource MetaValueStyle}"
                       AutomationProperties.AutomationId="TxtAboutArchitecture"/>
          </Grid>

          <!-- Repository: a real link, not a paragraph the user has to retype. -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Repository')}"
                       Style="{StaticResource SettingLabelStyle}"/>
            <HyperlinkButton Grid.Column="1"
                             Content="{x:Bind RepositoryLabel}"
                             NavigateUri="{x:Bind RepositoryUrl}"
                             Padding="0" MinHeight="0"
                             FontSize="{StaticResource FontSizeCaption}"
                             AutomationProperties.AutomationId="BtnAboutRepository"
                             AutomationProperties.Name="{x:Bind local:Loc.T('Open repository')}"
                             ToolTipService.ToolTip="{x:Bind RepositoryUrl}"/>
          </Grid>

          <TextBlock Text="{x:Bind local:Loc.T('GPL-3.0. Performix is free software; third-party components are listed in THIRD-PARTY-NOTICES.md.')}"
                     Style="{StaticResource SettingHintStyle}"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="TxtAboutLicense"/>

          <Button Content="{x:Bind local:Loc.T('Open logs folder')}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,12,0,0"
                  Click="OpenLogsFolder_Click"
                  AutomationProperties.AutomationId="BtnOpenLogs"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Open logs folder')}"
                  ToolTipService.ToolTip="{x:Bind LogsFolderPath}"/>

          <!-- UX review item 14: say WHEN this is useful, not just where the files are. -->
          <TextBlock Text="{x:Bind local:Loc.T('Logs and crash reports live next to the executable (shell.log, crash.log). Open them when you report a problem.')}"
                     Style="{StaticResource SettingHintStyle}"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="TxtLogsHint"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
