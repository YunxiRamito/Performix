<?xml version="1.0" encoding="utf-8"?>
<!--
  General — settings sub-page (IA phase 1, docs\design\UI-ARCH.md §1/§2).

  The "General" card of the old flat SettingsPage, unchanged in behaviour, on its own page:

    Language       5-item dropdown, applied immediately and saved to preysense.json
    Theme          navigation row → Pages\ThemePage (appearance controls live there)
    Run on Startup elevated scheduled task (switch disabled while the task state is read)
    Acer Services  stops / restores the OEM background services (switch)

  Layout rules (docs\UI-DESIGN-RULES.md):
    • one card inside the page ScrollViewer, shared CardStyle padding (12) and radius (6)
    • spacing only 4 / 6 / 8 / 12 / 16; font sizes only 11 / 12 / 16
    • row styles come from Styles\Resources.xaml (SettingRowStyle / SettingLabelStyle /
      SettingComboStyle / SettingSwitchStyle / SettingRowButtonStyle) so this page and
      Power share one rhythm
    • long explanations are a ToolTip on the muted info glyph (and AutomationProperties
      .HelpText), never a paragraph on the card

  Text is the English source string through Loc.T() → LocalizationService → UiText.
  Bindings are x:Bind only; the page owns no ViewModel and never touches hardware directly.
-->
<Page
    x:Class="Predex.WinUI.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PageGeneral"
    AutomationProperties.Name="{x:Bind local:Loc.T('General')}">

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">

      <TextBlock Text="{x:Bind local:Loc.T('Language, theme, startup and Acer services.')}"
                 Style="{StaticResource PageSubtitleStyle}"
                 AutomationProperties.AutomationId="TxtGeneralSubtitle"/>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <!-- ── Language ─────────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Language')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Applied immediately and saved to preysense.json. Missing translations fall back to English.')}"/>
            </Grid>

            <ComboBox x:Name="CmbLanguage" Grid.Column="1"
                      Style="{StaticResource SettingComboStyle}"
                      AutomationProperties.AutomationId="CmbLanguage"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Language')}"
                      AutomationProperties.HelpText="{x:Bind local:Loc.T('Applied immediately and saved to preysense.json. Missing translations fall back to English.')}"
                      SelectionChanged="Language_SelectionChanged">
              <ComboBoxItem Content="{x:Bind local:Loc.T('English')}" Tag="en-US"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Simplified Chinese')}" Tag="zh-CN"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Hindi')}" Tag="hi-IN"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('Spanish')}" Tag="es-ES"/>
              <ComboBoxItem Content="{x:Bind local:Loc.T('French')}" Tag="fr-FR"/>
            </ComboBox>
          </Grid>

          <!-- ── Theme → Pages\ThemePage (navigation, no duplicated control) ── -->
          <Button x:Name="BtnOpenTheme" Style="{StaticResource SettingRowButtonStyle}"
                  MinHeight="36" Click="OpenTheme_Click"
                  AutomationProperties.AutomationId="BtnOpenTheme"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Theme')}"
                  AutomationProperties.HelpText="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind local:Loc.T('Theme')}"
                           Style="{StaticResource SettingLabelStyle}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}"
                           Style="{StaticResource SettingHintStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SettingChevronStyle}"/>
            </Grid>
          </Button>

          <!-- ── Run on Startup ────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Run on Startup')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Registers an elevated scheduled task so Windows starts Performix with fan curves and lighting restored.')}"/>
            </Grid>

            <ToggleSwitch Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          IsOn="{x:Bind Vm.IsRunOnStartupEnabled, Mode=OneWay}"
                          IsEnabled="{x:Bind Vm.CanChangeRunOnStartup, Mode=OneWay}"
                          Toggled="RunOnStartup_Toggled"
                          AutomationProperties.AutomationId="ChkRunOnStartup"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Run on Startup')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Registers an elevated scheduled task so Windows starts Performix with fan curves and lighting restored.')}"/>
          </Grid>

          <!-- ── Acer Services ─────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Acer Services')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Stops and disables Acer OEM background services to free memory. The official Predator Sense app stops working until you re-enable them.')}"/>
            </Grid>

            <ToggleSwitch x:Name="ChkAcerServices" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          IsOn="{x:Bind Vm.IsAcerServicesEnabled, Mode=OneWay}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="AcerServices_Toggled"
                          AutomationProperties.AutomationId="ChkAcerServices"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Acer Services')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Stops and disables Acer OEM background services to free memory. The official Predator Sense app stops working until you re-enable them.')}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
