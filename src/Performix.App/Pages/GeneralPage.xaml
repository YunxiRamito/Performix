<?xml version="1.0" encoding="utf-8"?>
<!--
  General — settings sub-page (settings IA v2).

  Two cards:

    Card 1  Language / Run on Startup / Always on Top / Special Key Wake
    Card 2  Power Configuration (moved here from the deleted Power page):
              On Battery           5 profiles, persisted by the ViewModel (no command)
              On AC                 5 profiles, same mechanism
              USB Power-Off Charging  four-position dropdown + write-readback line
              Battery Limit          switch + a bar showing the active charge cap
              Energy Saver on Battery Windows energy saver while on battery (kept: it was a
                                     working setting before the restructure and the design
                                     did not ask for a feature to be removed)

  HONESTY RULES
    • Always on Top and Special Key Wake are real switches now (they used to be disabled rows
      saying "not available"). What they do:
        Always on Top     OverlappedPresenter.IsAlwaysOnTop on the shell window, and while it is
                          on the panel stops hiding itself when it loses focus — the auto-hide
                          is what made "topmost" meaningless before (ShellWindow
                          .ApplyAlwaysOnTop + WindowBehaviorPolicy).
        Special Key Wake  the Predator key (scan code E0 75, KeyboardHookService) summons the
                          panel from any app; off drops that summon. The chassis mode key
                          (ACPI-WMI APGeEvent) changes the power mode and never opened the
                          window, so this switch does not pretend to cover it.
      Both persist to preysense.json (General.AlwaysOnTop / General.SpecialKeyWake) and are
      applied at startup, so a restart keeps them (Services\WindowBehaviorSettings.cs).
    • The design's AC entry "restore the original configuration" is not offered either:
      Session.AcPowerMode only accepts the five profile bytes (Core folder, not editable from
      this stage), so there is no state to store for it. Five profiles are shown for both
      sources instead of inventing a sixth value the backend cannot persist.
    • The battery bar shows the real charge cap the ViewModel holds (MainViewModel
      .BatteryLimitPercent: 80 when the limit is on, 100 when it is off), not a fake percentage.

  Layout rules (docs\UI-DESIGN-RULES.md):
    • cards use the shared CardStyle padding (12) and radius (6); spacing 4 / 6 / 8 / 12 / 16
    • font sizes only 11 / 12 / 16; every row uses the Setting* styles from Styles\Resources.xaml
    • long explanations are a ToolTip on the muted info glyph, never a paragraph on the card
    • text is the English source string through Loc.T() → LocalizationService; bindings are
      x:Bind only, and the page owns no ViewModel of its own
-->
<Page
    x:Class="Predex.WinUI.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PageGeneral"
    AutomationProperties.Name="{x:Bind local:Loc.T('General')}">

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">

      <!-- ═══ CARD 1 · LANGUAGE / STARTUP / WINDOW BEHAVIOUR ═══ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <!-- ── Language ─────────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Language')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('The list stays open for new languages: adding one means adding one table.')}"/>
            </Grid>

            <!-- The items are built in code from LocalizationService.LanguageOptions so the
                 picker and the translation tables cannot drift, and so every entry shows its
                 own native name (a language list must never be translated). -->
            <ComboBox x:Name="CmbLanguage" Grid.Column="1"
                      Style="{StaticResource SettingComboStyle}"
                      AutomationProperties.AutomationId="CmbLanguage"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Language')}"
                      AutomationProperties.HelpText="{x:Bind local:Loc.T('The list stays open for new languages: adding one means adding one table.')}"
                      SelectionChanged="Language_SelectionChanged"/>
          </Grid>

          <!-- ── Run on Startup ────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Run on Startup')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Starts Performix when Windows starts, so fan curves and lighting are already in effect.')}"/>
            </Grid>

            <ToggleSwitch Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          IsOn="{x:Bind Vm.IsRunOnStartupEnabled, Mode=OneWay}"
                          IsEnabled="{x:Bind Vm.CanChangeRunOnStartup, Mode=OneWay}"
                          Toggled="RunOnStartup_Toggled"
                          AutomationProperties.AutomationId="ChkRunOnStartup"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Run on Startup')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Starts Performix when Windows starts, so fan curves and lighting are already in effect.')}"/>
          </Grid>

          <!-- ── Always on Top ─────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Always on Top')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Keeps the panel above other windows, and it stays open when you click another window.')}"/>
            </Grid>

            <ToggleSwitch x:Name="ChkAlwaysOnTop" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="AlwaysOnTop_Toggled"
                          AutomationProperties.AutomationId="ChkAlwaysOnTop"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Always on Top')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Keeps the panel above other windows, and it stays open when you click another window.')}"/>
          </Grid>

          <!-- ── Special Key Wake ──────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Special Key Wake')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('The Predator key opens the panel from any app. Off leaves the key without that action.')}"/>
            </Grid>

            <ToggleSwitch x:Name="ChkSpecialKeyWake" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="SpecialKeyWake_Toggled"
                          AutomationProperties.AutomationId="ChkSpecialKeyWake"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Special Key Wake')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('The Predator key opens the panel from any app. Off leaves the key without that action.')}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ CARD 2 · POWER CONFIGURATION (former Power page) ═══ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <TextBlock Text="{x:Bind local:Loc.T('Power Configuration')}"
                     Style="{StaticResource SectionTitleStyle}"
                     Margin="0,0,0,4"
                     AutomationProperties.AutomationId="TxtPowerConfigurationTitle"/>

          <!-- ── On Battery ───────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('On Battery')}"
                       Style="{StaticResource SettingLabelStyle}"/>

            <!-- The items are built in code from ProfileNames (see BuildPowerModeItems): an
                 ItemsSource x:Bind resolves after the first layout pass, and a SelectedIndex
                 written before that lands on an empty list and stays -1 — the empty box the
                 review reported. -->
            <ComboBox x:Name="CmbBatteryPowerMode" Grid.Column="1"
                      Style="{StaticResource SettingComboStyle}"
                      PlaceholderText="{x:Bind local:Loc.T('Unknown')}"
                      SelectionChanged="BatteryPowerMode_SelectionChanged"
                      AutomationProperties.AutomationId="CmbBatteryPowerMode"
                      AutomationProperties.Name="{x:Bind local:Loc.T('On Battery')}"/>
          </Grid>

          <!-- ── On AC ────────────────────────────────────────────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('On AC')}"
                       Style="{StaticResource SettingLabelStyle}"/>

            <ComboBox x:Name="CmbAcPowerMode" Grid.Column="1"
                      Style="{StaticResource SettingComboStyle}"
                      PlaceholderText="{x:Bind local:Loc.T('Unknown')}"
                      SelectionChanged="AcPowerMode_SelectionChanged"
                      AutomationProperties.AutomationId="CmbAcPowerMode"
                      AutomationProperties.Name="{x:Bind local:Loc.T('On AC')}"/>
          </Grid>

          <!-- ── USB Power-Off Charging (0..30, step 10; 0 shows Off) ──────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('USB Power-Off Charging')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Charges devices from the supported USB port while the laptop is off. Stops at the selected laptop battery level and uses battery power.')}"/>
            </Grid>

            <ComboBox x:Name="CmbUsbCharging" Grid.Column="1"
                      Style="{StaticResource SettingComboStyle}"
                      IsEnabled="{x:Bind Vm.CanChangeUsbCharging, Mode=OneWay}"
                      SelectionChanged="UsbCharging_SelectionChanged"
                      AutomationProperties.AutomationId="CmbUsbCharging"
                      AutomationProperties.Name="{x:Bind local:Loc.T('USB Power-Off Charging')}"
                      AutomationProperties.HelpText="{x:Bind local:Loc.T('Charges devices from the supported USB port while the laptop is off. Stops at the selected laptop battery level and uses battery power.')}">
              <ComboBoxItem Content="{x:Bind local:Loc.T('Off')}" Tag="0"/>
              <ComboBoxItem Content="10%" Tag="10"/>
              <ComboBoxItem Content="20%" Tag="20"/>
              <ComboBoxItem Content="30%" Tag="30"/>
            </ComboBox>
          </Grid>

          <!-- Readback failure / N/A line. Empty means the write round-tripped cleanly. -->
          <TextBlock Text="{x:Bind Vm.UsbChargingStatus, Mode=OneWay}"
                     Style="{StaticResource SettingHintStyle}"
                     Visibility="{x:Bind StatusVisibility(Vm.UsbChargingStatus), Mode=OneWay}"
                     Margin="0,0,0,4"
                     AutomationProperties.AutomationId="TxtUsbChargingStatus"
                     AutomationProperties.LiveSetting="Polite"/>

          <!-- ── Battery Limit: switch + the bar of the active charge cap ──── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="4" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:Loc.T('Battery Limit')}"
                         Style="{StaticResource SettingLabelStyle}"/>
              <FontIcon Grid.Column="1"
                        Style="{StaticResource SettingHelpGlyphStyle}"
                        ToolTipService.ToolTip="{x:Bind local:Loc.T('Caps charging at 80% to slow battery wear. Turned off the battery charges to 100%.')}"/>
            </Grid>

            <ToggleSwitch x:Name="ChkBatteryLimit" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          IsOn="{x:Bind Vm.IsBatteryLimitEnabled, Mode=OneWay}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="BatteryLimit_Toggled"
                          AutomationProperties.AutomationId="ChkBatteryLimit"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Battery Limit')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Caps charging at 80% to slow battery wear. Turned off the battery charges to 100%.')}"/>
          </Grid>

          <!-- The cap itself: 6 DIP bar + the "Charge cap 80%" label. The value is
               MainViewModel.BatteryLimitPercent, so the bar always agrees with the switch. -->
          <StackPanel Spacing="4" Margin="0,0,0,6">
            <ProgressBar x:Name="PrgBatteryLimit" Height="6"
                         Minimum="0" Maximum="100"
                         Value="{x:Bind Vm.BatteryLimitPercent, Mode=OneWay}"
                         CornerRadius="3"
                         Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                         Background="{ThemeResource ProgressTrackBrush}"
                         AutomationProperties.AutomationId="PrgBatteryLimit"
                         AutomationProperties.Name="{x:Bind local:Loc.T('Battery Limit')}"/>
            <TextBlock Text="{x:Bind CapText(Vm.BatteryLimitPercent), Mode=OneWay}"
                       Style="{StaticResource SettingHintStyle}"
                       AutomationProperties.AutomationId="TxtBatteryLimitCap"
                       AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>

          <!-- ── Energy Saver on Battery (TwoWay, no command) ──────────────── -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('Energy Saver on Battery')}"
                       Style="{StaticResource SettingLabelStyle}"/>

            <ToggleSwitch x:Name="ChkEnergySaverOnBattery" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          IsOn="{x:Bind Vm.IsBatteryEnergySaverEnabled, Mode=TwoWay}"
                          AutomationProperties.AutomationId="ChkEnergySaverOnBattery"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Energy Saver on Battery')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('Turns on the Windows Energy Saver while the laptop runs from battery.')}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
