<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings — the directory page (IA phase 1, docs\design\UI-ARCH.md §1/§2).

  It used to be the whole settings surface: language, startup, Acer services, battery limit,
  USB charging and both power profiles were pinned on this one page. The design splits the
  settings tree into one directory page + four sub-pages, so this page is now a list of four
  navigation rows and nothing else:

    General            Language / Theme entry / Run on Startup / Acer services
    Power Profiles     Battery limit / USB power-off charging (+ readback) / On battery /
                       On AC / Energy saver on battery
    Theme              the existing ThemePage (content untouched, still reached from here)
    Updates and About  version, update placeholder, build / logs / licence

  RULES
    • only a directory: no setting is duplicated here, every row navigates (SHELL-CONTRACT §2)
    • one card, one column; row = title left + subtitle under it, chevron right
    • the navigation-row / label / hint / chevron styles live in Styles\Resources.xaml so the
      hub, General and Power share one row rhythm (they came out of this page)
    • the version string sits at the top right of the page header — the shell title bar is
      reserved for the wordmark and the CPU/GPU temperatures (UI-ARCH §2.8)
    • text is the English source string through Loc.T(); long explanations are a ToolTip
-->
<Page
    x:Class="Predex.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PageSettings"
    AutomationProperties.Name="{x:Bind local:Loc.T('Settings')}">

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch">

      <!-- ═══════════════════════════════════════════════════════════════════
           PAGE SUBTITLE + VERSION
           One subtitle line, no repeated page heading: the shell title bar already says
           "设置". The version is the only dynamic text on this page.
           ═══════════════════════════════════════════════════════════════════ -->
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{x:Bind local:Loc.T('Language, power, appearance, updates and about.')}"
                   Style="{StaticResource PageSubtitleStyle}"
                   VerticalAlignment="Top"
                   AutomationProperties.AutomationId="TxtSettingsSubtitle"/>
        <TextBlock Grid.Column="1" Text="{x:Bind VersionText}"
                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Top"
                   ToolTipService.ToolTip="{x:Bind VersionText}"
                   AutomationProperties.AutomationId="TxtSettingsVersion"/>
      </Grid>

      <!-- ═══════════════════════════════════════════════════════════════════
           SETTINGS DIRECTORY — four navigation rows
           ═══════════════════════════════════════════════════════════════════ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <!-- ── General ─────────────────────────────────────────────────── -->
          <Button x:Name="BtnSettingsGeneral"
                  Style="{StaticResource SettingRowButtonStyle}"
                  MinHeight="44" Click="OpenGeneral_Click"
                  AutomationProperties.AutomationId="BtnSettingsGeneral"
                  AutomationProperties.Name="{x:Bind local:Loc.T('General')}"
                  AutomationProperties.HelpText="{x:Bind local:Loc.T('Language, startup and Acer services.')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Language, startup and Acer services.')}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind local:Loc.T('General')}"
                           Style="{StaticResource SettingLabelStyle}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Language, startup and Acer services.')}"
                           Style="{StaticResource SettingHintStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SettingChevronStyle}"/>
            </Grid>
          </Button>

          <!-- ── Power Profiles ──────────────────────────────────────────── -->
          <Button x:Name="BtnSettingsPower"
                  Style="{StaticResource SettingRowButtonStyle}"
                  MinHeight="44" Click="OpenPower_Click"
                  AutomationProperties.AutomationId="BtnSettingsPower"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Power Profiles')}"
                  AutomationProperties.HelpText="{x:Bind local:Loc.T('Battery limit, USB power-off charging and power profiles.')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Battery limit, USB power-off charging and power profiles.')}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind local:Loc.T('Power Profiles')}"
                           Style="{StaticResource SettingLabelStyle}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Battery limit, USB power-off charging and power profiles.')}"
                           Style="{StaticResource SettingHintStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SettingChevronStyle}"/>
            </Grid>
          </Button>

          <!-- ── Theme (existing page, content untouched) ────────────────── -->
          <Button x:Name="BtnSettingsTheme"
                  Style="{StaticResource SettingRowButtonStyle}"
                  MinHeight="44" Click="OpenTheme_Click"
                  AutomationProperties.AutomationId="BtnSettingsTheme"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Theme')}"
                  AutomationProperties.HelpText="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind local:Loc.T('Theme')}"
                           Style="{StaticResource SettingLabelStyle}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Appearance, window shape, material and accent colour.')}"
                           Style="{StaticResource SettingHintStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SettingChevronStyle}"/>
            </Grid>
          </Button>

          <!-- ── Updates and About ─────────────────────────────────────────
               Subtitle carries the version + the honest update-feed state, so the row is
               useful without opening it (IA phase 1: no fake update progress anywhere). -->
          <Button x:Name="BtnSettingsMeta"
                  Style="{StaticResource SettingRowButtonStyle}"
                  MinHeight="44" Click="OpenMeta_Click"
                  AutomationProperties.AutomationId="BtnSettingsMeta"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Updates and About')}"
                  AutomationProperties.HelpText="{x:Bind MetaSubtitle}"
                  ToolTipService.ToolTip="{x:Bind MetaSubtitle}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind local:Loc.T('Updates and About')}"
                           Style="{StaticResource SettingLabelStyle}"/>
                <TextBlock Text="{x:Bind MetaSubtitle}" Style="{StaticResource SettingHintStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SettingChevronStyle}"/>
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
