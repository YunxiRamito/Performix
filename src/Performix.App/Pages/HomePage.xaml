<?xml version="1.0" encoding="utf-8"?>
<!--
  Home page (S1). Two states on one visual tree (docs\UI-DESIGN-RULES.md §6):

    Collapsed (default): 10 + 52 tiles + 12            = 74  → window 116 with the 40 title
    Expanded:            + 164                          = 238 → window 280

  One border language: 1 px dividers between groups, no cards, no card-in-card tiles.
  Spacing is 4/6/8/12 only, font sizes 11/12/16 only.

  S2 integration pass (external design review):
    * selection is the ONLY accent in this view — every tile (5 performance modes and the
      4 GPU modes) uses the same #3B82F6 border + #263B82F6 fill when active, and its icon is
      accent-coloured only while active. The per-mode rainbow icons (green/cyan/blue/pink/
      purple) are gone: pink read as "danger" on 高级/独显 and made the selected blue shout
      less. Icons are #A8A8BC when idle.
    * the expanded telemetry row shows fan RPM only. CPU/GPU temperature already sits in the
      40 DIP title bar (that is deliberate, the collapsed state has no other place for it);
      repeating it here wasted width on a 320 DIP window.
    * the refresh-rate "Auto" chip is labelled "Auto refresh" / 自动刷新 so it cannot be
      confused with the GPU-mode "Auto" tile right above it.

  R2 consistency pass:
    * One row rhythm: the whole stack is a single StackPanel with Spacing=GapTight, so the
      gaps between the mode row, the RPM line, the dividers and the three expanded groups are
      the same 6 DIP. Before, the RPM line had 6 above and ~13 below, which is what made
      "the mode row sits too close to the speed line" read as an uneven rhythm.
    * One column grid: the 5-up rows (mode tiles, entry buttons) share ColumnSpacing so
      their column lines land on the same x. The GPU row has 4 items and divides its own row
      evenly — its left and right edges are the same content box as the 5-up rows (that is
      the acceptance; 4 cannot produce the same internal lines as 5).
    * The tiles are the shared ModeTileButtonStyle control; the tuning page renders the same
      control from the same style, so the two selectors cannot drift again.
    * "Auto refresh" is a chip button (accent fill = on), not blue text on a transparent
      surface: the old one read as a link and hid its own state.
-->
<Page
    x:Class="Predex.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False">

  <Grid x:Name="HomeRoot">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="DensityStates">
        <VisualState x:Name="Collapsed"/>
        <VisualState x:Name="Expanded">
          <VisualState.Setters>
            <Setter Target="ExpandedArea.Visibility" Value="Visible"/>
            <Setter Target="ExpandHint.Visibility" Value="Collapsed"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <StackPanel x:Name="HomeContent" Padding="12,8,12,12"
                Spacing="{StaticResource GapTight}">

      <!-- ═══ PERFORMANCE MODES (the only row in the collapsed state) ═══ -->
      <Grid x:Name="ModeTiles" ColumnSpacing="{StaticResource GapTight}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsEcoActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="6"
                AutomationProperties.AutomationId="BtnModeEco"
                AutomationProperties.Name="{x:Bind local:Loc.T('Eco')}"
                ToolTipService.ToolTip="{x:Bind local:Loc.T('Eco')}">
          <StackPanel Style="{StaticResource ModeTileStackStyle}">
            <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsEcoActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE8BE;"/>
            <TextBlock Text="{x:Bind local:Loc.T('Eco')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsEcoActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsQuietActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="0"
                AutomationProperties.AutomationId="BtnModeQuiet"
                AutomationProperties.Name="{x:Bind local:Loc.T('Quiet')}"
                ToolTipService.ToolTip="{x:Bind local:Loc.T('Quiet')}">
          <StackPanel Style="{StaticResource ModeTileStackStyle}">
            <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsQuietActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE708;"/>
            <TextBlock Text="{x:Bind local:Loc.T('Quiet')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsQuietActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBalancedActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="1"
                AutomationProperties.AutomationId="BtnModeBalanced"
                AutomationProperties.Name="{x:Bind local:Loc.T('Balanced')}"
                ToolTipService.ToolTip="{x:Bind local:Loc.T('Balanced')}">
          <StackPanel Style="{StaticResource ModeTileStackStyle}">
            <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBalancedActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE9E9;"/>
            <TextBlock Text="{x:Bind local:Loc.T('Bal')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBalancedActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="3" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsPerformActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="4"
                AutomationProperties.AutomationId="BtnModePerformance"
                AutomationProperties.Name="{x:Bind local:Loc.T('Performance')}"
                ToolTipService.ToolTip="{x:Bind local:Loc.T('Performance')}">
          <StackPanel Style="{StaticResource ModeTileStackStyle}">
            <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsPerformActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xEC4A;"/>
            <TextBlock Text="{x:Bind local:Loc.T('Perf')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsPerformActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
          </StackPanel>
        </Button>

        <Button Grid.Column="4" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsTurboActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                Command="{x:Bind ViewModel.SetModeCommand}" CommandParameter="5"
                AutomationProperties.AutomationId="BtnModeTurbo"
                AutomationProperties.Name="{x:Bind local:Loc.T('Beast')}"
                ToolTipService.ToolTip="{x:Bind local:Loc.T('Beast')}">
          <StackPanel Style="{StaticResource ModeTileStackStyle}">
            <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsTurboActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE945;"/>
            <TextBlock Text="{x:Bind local:Loc.T('Beast')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsTurboActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Hint only visible while collapsed (row lives out of the way of the 116 DIP budget) -->
      <TextBlock x:Name="ExpandHint" Visibility="Collapsed" Style="{StaticResource CaptionTextStyle}"/>

      <!-- ═══ EXPANDED AREA ═══ -->
      <StackPanel x:Name="ExpandedArea" Visibility="Collapsed"
                  Spacing="{StaticResource GapTight}">

        <!-- Live fan telemetry (real EC readings through IHardwareService).
             Temperatures stay in the title bar — showing them here too duplicated the data.
             No Margin: the parent's Spacing already gives this row the same 6 DIP above and
             below as every other group in the expanded area. -->
        <Grid x:Name="TelemetryRow" Height="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}"/>
            <TextBlock Text="{x:Bind local:Converters.Telemetry(ViewModel.CpuFanText), Mode=OneWay}"
                       Style="{StaticResource StatusTextStyle}"
                       ToolTipService.ToolTip="{x:Bind local:Loc.T('CPU Fan')}"
                       AutomationProperties.AutomationId="TxtHomeCpuFan"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="GPU" Style="{StaticResource CaptionTextStyle}"/>
            <TextBlock Text="{x:Bind local:Converters.Telemetry(ViewModel.GpuFanText), Mode=OneWay}"
                       Style="{StaticResource StatusTextStyle}"
                       ToolTipService.ToolTip="{x:Bind local:Loc.T('GPU Fan')}"
                       AutomationProperties.AutomationId="TxtHomeGpuFan"/>
          </StackPanel>
        </Grid>

        <Border Height="1" Background="{StaticResource BorderSubtleBrush}"/>

        <!-- GPU MODE header (H1): the row had no label and no visible selection. Left title
             12 SemiBold Secondary, right current mode 11 Muted, 6 DIP to the tiles (the
             ExpandedArea Spacing supplies it). Costs 20 DIP: the expanded window is 300 now
             (280 + the header row), the collapsed density stays 116. -->
        <Grid x:Name="GpuHeaderRow" Height="14" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{x:Bind local:Loc.T('GPU Mode')}"
                     Style="{StaticResource SectionTitleStyle}"
                     AutomationProperties.AutomationId="TxtGpuModeHeader"/>
          <!-- R4 bug 1: GpuMuxModeName is "N/A" when the DDS/MUX read failed (this box has no
               switchable MUX: ActiveGpuMuxMode = -1). Per UI-DESIGN-RULES §5 a missing reading
               is an em dash, never "N/A" — Converters.Telemetry does exactly that mapping. -->
          <TextBlock Grid.Column="1"
                     Text="{x:Bind local:Converters.Telemetry(ViewModel.GpuMuxModeName), Mode=OneWay}"
                     Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"
                     ToolTipService.ToolTip="{x:Bind local:Loc.T('GPU mode is not readable on this hardware (no MUX / DDS).')}"
                     AutomationProperties.AutomationId="TxtGpuModeValue"/>
        </Grid>

        <!-- GPU MODE: 4 items, one even division of the same content box as the 5-up rows.
             UpdateGpuTileLayout() spans two columns each when the DDS tiles are hidden. -->
        <Grid x:Name="GpuGroup" Height="44" ColumnSpacing="{StaticResource GapTight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="GpuAutoTile" Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAutoActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                  Height="44" Padding="4,4"
                  Command="{x:Bind ViewModel.SetGpuMuxModeCommand}" CommandParameter="1"
                  AutomationProperties.AutomationId="BtnGpuAuto"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Auto')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Auto')}">
            <StackPanel Style="{StaticResource ModeTileStackStyle}">
              <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAutoActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE7E8;"/>
              <TextBlock Text="{x:Bind local:Loc.T('Auto')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAutoActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </StackPanel>
          </Button>

          <Button x:Name="GpuHybridTile" Grid.Column="1" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuOptimusActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                  Height="44" Padding="4,4"
                  Visibility="{x:Bind local:Converters.BoolToVis(ViewModel.ShowDdsGpuTiles), Mode=OneWay}"
                  Command="{x:Bind ViewModel.SetGpuMuxModeCommand}" CommandParameter="0"
                  AutomationProperties.AutomationId="BtnGpuHybrid"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Hybrid')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Hybrid')}">
            <StackPanel Style="{StaticResource ModeTileStackStyle}">
              <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuOptimusActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE977;"/>
              <TextBlock Text="{x:Bind local:Loc.T('Hybrid')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuOptimusActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </StackPanel>
          </Button>

          <Button x:Name="GpuAdvancedTile" Grid.Column="2" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAdvancedOptimusActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                  Height="44" Padding="4,4"
                  Visibility="{x:Bind local:Converters.BoolToVis(ViewModel.ShowDdsGpuTiles), Mode=OneWay}"
                  Command="{x:Bind ViewModel.SetGpuMuxModeCommand}" CommandParameter="2"
                  AutomationProperties.AutomationId="BtnGpuAdvanced"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Advanced Optimus')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Advanced Optimus')}">
            <StackPanel Style="{StaticResource ModeTileStackStyle}">
              <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAdvancedOptimusActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE895;"/>
              <TextBlock Text="{x:Bind local:Loc.T('Adv')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsGpuAdvancedOptimusActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </StackPanel>
          </Button>

          <Button x:Name="GpuDiscreteTile" Grid.Column="3" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBiosDiscreteGpuActive, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                  Height="44" Padding="4,4"
                  Command="{x:Bind ViewModel.SetBiosDiscreteGpuCommand}"
                  AutomationProperties.AutomationId="BtnGpuDiscrete"
                  AutomationProperties.Name="{x:Bind local:Loc.T('dGPU Only')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('dGPU Only')}">
            <StackPanel Style="{StaticResource ModeTileStackStyle}">
              <FontIcon Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBiosDiscreteGpuActive, 'ModeTileIconSelectedStyle', 'ModeTileIconStyle'), Mode=OneWay}" Glyph="&#xE912;"/>
              <TextBlock Text="{x:Bind local:Loc.T('dGPU')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsBiosDiscreteGpuActive, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </StackPanel>
          </Button>
        </Grid>

        <Border Height="1" Background="{StaticResource BorderSubtleBrush}"/>

        <!-- DISPLAY: auto-refresh chip + refresh rate + current display mode -->
        <Grid x:Name="DisplayGroup" Height="30" ColumnSpacing="{StaticResource GapTight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Chip button: ON = accent fill + white label, OFF = neutral fill + secondary
               label. It is an on/off control, so it may use the accent as a solid fill; the
               tiles keep the 15 % accent tint because there the accent marks a selection. -->
          <Button Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsAutoRefreshRateEnabled, 'ChipButtonSelectedStyle', 'ChipButtonStyle'), Mode=OneWay}"
                  Command="{x:Bind ViewModel.ToggleAutoRefreshRateCommand}"
                  AutomationProperties.AutomationId="BtnAutoRefresh"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Auto refresh')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Refresh rate')}">
            <TextBlock Text="{x:Bind local:Loc.T('Auto refresh')}" Style="{x:Bind local:Converters.BoolToStyle(ViewModel.IsAutoRefreshRateEnabled, 'ChipLabelSelectedStyle', 'ChipLabelStyle'), Mode=OneWay}"/>
          </Button>

          <ComboBox Grid.Column="1" Height="30" Width="96" CornerRadius="4" FontSize="11"
                    ItemsSource="{x:Bind ViewModel.AvailableRefreshRates}"
                    SelectedItem="{x:Bind ViewModel.SelectedRefreshRateOption, Mode=TwoWay}"
                    AutomationProperties.AutomationId="CmbRefreshRate"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Refresh rate')}"/>

          <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ActiveGpuDisplayMode, Mode=OneWay}"
                     Style="{StaticResource CaptionTextStyle}"
                     TextTrimming="CharacterEllipsis" MaxLines="1"
                     ToolTipService.ToolTip="{x:Bind ViewModel.ActiveGpuDisplayMode, Mode=OneWay}"/>
        </Grid>

        <Border Height="1" Background="{StaticResource BorderSubtleBrush}"/>

        <!-- ENTRY POINTS: every remaining page is one click away in the same window.
             5 equal columns with the same spacing as the mode row, so both 5-up rows
             share their column lines. -->
        <Grid x:Name="EntryGroup" Height="28" ColumnSpacing="{StaticResource GapTight}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource EntryButtonStyle}" Height="28"
                  Click="LightingShortcut_Click"
                  AutomationProperties.AutomationId="OpenLighting"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Lighting')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Lighting')}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE9A9;" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Text="{x:Bind local:Loc.T('Lighting')}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         MaxLines="1" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Style="{StaticResource EntryButtonStyle}" Height="28"
                  Click="OverlayShortcut_Click"
                  AutomationProperties.AutomationId="OpenOverlay"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Overlay')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Overlay')}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE7C4;" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Text="{x:Bind local:Loc.T('Overlay')}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         MaxLines="1" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Style="{StaticResource EntryButtonStyle}" Height="28"
                  Click="FansShortcut_Click"
                  AutomationProperties.AutomationId="OpenFans"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Fans')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Fans')}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Text="{x:Bind local:Loc.T('Fans')}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         MaxLines="1" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="3" Style="{StaticResource EntryButtonStyle}" Height="28"
                  Click="TuningShortcut_Click"
                  AutomationProperties.AutomationId="OpenTuning"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Tuning')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Tuning')}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Text="{x:Bind local:Loc.T('Tuning')}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         MaxLines="1" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="4" Style="{StaticResource EntryButtonStyle}" Height="28"
                  Click="SettingsShortcut_Click"
                  AutomationProperties.AutomationId="OpenSettings"
                  AutomationProperties.Name="{x:Bind local:Loc.T('Settings')}"
                  ToolTipService.ToolTip="{x:Bind local:Loc.T('Settings')}">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock Text="{x:Bind local:Loc.T('Settings')}" FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         MaxLines="1" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
