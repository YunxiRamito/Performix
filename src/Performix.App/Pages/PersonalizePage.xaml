<?xml version="1.0" encoding="utf-8"?>
<!--
  Personalisation — settings sub-page (settings IA v2). Replaces the old Theme page: the same
  appearance controls, plus the new Interface group the design asks for.

  Card 1 · Theme      Appearance mode (Dark / Light / Follow system)
                      Window style    (Windows 11 round / Windows 10 square)
                      Material        (Mica / Acrylic / Solid — unsupported ones greyed, never hidden)
                      Accent colour   (Follow Windows / Blue #3B82F6 / Custom: 160 DIP ColorSpectrum
                                       ring + hex box + 8 preset swatches). Choosing Custom opens
                                       the picker flyout itself; the 28 DIP swatch beside the
                                       combo carries a pencil badge as the visible shortcut.

  Card 2 · Interface  Four switches over the rows of the expanded home panel:

                        Status bar        HomePage.TelemetryRow  (the read-only telemetry line)
                        GPU bar           HomePage.GpuHeaderRow + GpuGroup
                        Refresh rate bar  HomePage.DisplayGroup (auto-refresh + Hz + mode)
                        Widget bar        the lighting / HUD / fans / tuning entries

                      Under "Status bar" sit its four fields — Temperature / Usage / Frequency /
                      Fan speed — each one an independent CheckBox: they decide what that single
                      14 DIP line prints (CPU and GPU alike), not whether it exists. A field the
                      machine cannot read still renders "—" (UI-DESIGN-RULES §5), so none of them
                      is greyed out; all four are backed by the shared telemetry snapshot.

                      Every one of them is wired: AppearanceService.SetUiPanel writes the flag
                      into appearance.json (the file the appearance controls already own) and
                      raises UiPanelsChanged, HomePage hides the row immediately, and the flag
                      is read back on the next start. The Settings entry of the widget row is
                      deliberately outside the switch — hiding it would leave no way back in.

  Every appearance control is applied by Predex.WinUI.Services.AppearanceService the moment it
  changes — there is no Apply button — and each change writes one line to shell.log
  (`appearance:`).

  Layout rules (docs\UI-DESIGN-RULES.md / SHELL-CONTRACT.md §3 + §5):
    • one ScrollViewer, cards with the shared CardStyle padding (12) and radius (6)
    • spacing only 4 / 6 / 8 / 12 / 16; font sizes only 11 / 12 / 16
    • the page never repeats its title (the shell title bar already says 个性化)
    • text is the English source string through Loc.T(); long explanations live in a
      ToolTip on the muted info glyph (and in AutomationProperties.HelpText)
    • the tile surfaces come from resource-key brushes (TileFillBrush / TileSelectedFillBrush /
      AccentBrush) instead of hex literals so a light-theme or accent change repaints them
      immediately: AppearanceService recolours those shared SolidColorBrush instances.
-->
<Page
    x:Class="Predex.WinUI.Pages.PersonalizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Predex.WinUI"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Background="Transparent"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.AutomationId="PagePersonalize"
    AutomationProperties.Name="{x:Bind local:Loc.T('Personalisation')}">

  <Page.Resources>
    <Style x:Key="ThemeLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxLines" Value="2"/>
    </Style>

    <!-- Info glyph: the explanation is the ToolTip, never a paragraph on the card. -->
    <Style x:Key="ThemeHelpGlyphStyle" TargetType="FontIcon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="Glyph" Value="&#xE946;"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>

    <!-- Same shape as the Settings combos (30 high, 132 wide, no white focus ring). -->
    <Style x:Key="ThemeComboStyle" TargetType="ComboBox">
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
      <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
      <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <Style x:Key="ThemeHintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- The four status-bar fields. A CheckBox, not a ToggleSwitch: they are fields of one row,
         not four more rows, and the switch column above is reserved for the row switches.
         28 DIP high so the hit target still passes UI-DESIGN-RULES §8 #14. -->
    <Style x:Key="StatusFieldCheckStyle" TargetType="CheckBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ThemeTileCaptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="MaxLines" Value="1"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{ThemeResource ModeTileTextBrush}"/>
    </Style>

    <!-- 28 DIP accent preset swatch inside the flyout: a plain Button whose Background is the
         colour; radius comes from the appearance token so Windows 10 style squares it too. -->
    <Style x:Key="ThemeSwatchButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{ThemeResource AppControlCornerRadius}"/>
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="12,10,12,12"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="4" MaxWidth="640" HorizontalAlignment="Stretch" VerticalAlignment="Top">

      <!-- ═══ CARD 1 · THEME ═══ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <TextBlock Text="{x:Bind local:Loc.T('Theme')}"
                     Style="{StaticResource SectionTitleStyle}"/>

          <!-- ═══ APPEARANCE MODE: 3 tiles, Home's selected language ═══ -->
          <TextBlock Text="{x:Bind local:Loc.T('Appearance mode')}"
                     Style="{StaticResource ThemeLabelStyle}"
                     Margin="0,8,0,0"/>
          <Grid ColumnSpacing="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(IsDarkSelected, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Click="DarkTile_Click"
                    AutomationProperties.AutomationId="BtnThemeDark"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Dark')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Dark surfaces, the default look.')}">
              <TextBlock Text="{x:Bind local:Loc.T('Dark')}" Style="{x:Bind local:Converters.BoolToStyle(IsDarkSelected, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </Button>

            <Button Grid.Column="1" Style="{x:Bind local:Converters.BoolToStyle(IsLightSelected, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Click="LightTile_Click"
                    AutomationProperties.AutomationId="BtnThemeLight"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Light')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Light surfaces for a bright room.')}">
              <TextBlock Text="{x:Bind local:Loc.T('Light')}" Style="{x:Bind local:Converters.BoolToStyle(IsLightSelected, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </Button>

            <Button Grid.Column="2" Style="{x:Bind local:Converters.BoolToStyle(IsSystemThemeSelected, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Click="SystemTile_Click"
                    AutomationProperties.AutomationId="BtnThemeSystem"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Follow system')}"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Matches the Windows light / dark setting and follows it while Performix runs.')}">
              <TextBlock Text="{x:Bind local:Loc.T('Follow system')}" Style="{x:Bind local:Converters.BoolToStyle(IsSystemThemeSelected, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
            </Button>
          </Grid>

          <!-- ═══ WINDOW STYLE: DWM corner + control radius tokens ═══ -->
          <Grid ColumnSpacing="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Window style')}"
                       Style="{StaticResource ThemeLabelStyle}"/>
            <FontIcon Grid.Column="1"
                      Style="{StaticResource ThemeHelpGlyphStyle}"
                      ToolTipService.ToolTip="{x:Bind local:Loc.T('Windows 11 draws a rounded window and rounded controls; Windows 10 squares both. Applied through DWM and the corner-radius tokens.')}"/>
          </Grid>
          <Grid ColumnSpacing="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{x:Bind local:Converters.BoolToStyle(IsWin11StyleSelected, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Click="Win11Tile_Click"
                    AutomationProperties.AutomationId="BtnStyleWin11"
                    AutomationProperties.Name="Windows 11"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Rounded window corner and 4 / 6 DIP control radii.')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <TextBlock Text="Windows 11" Style="{x:Bind local:Converters.BoolToStyle(IsWin11StyleSelected, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Rounded')}" Style="{StaticResource ThemeTileCaptionStyle}"/>
              </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{x:Bind local:Converters.BoolToStyle(IsWin10StyleSelected, 'ModeTileButtonSelectedStyle', 'ModeTileButtonStyle'), Mode=OneWay}"
                    Click="Win10Tile_Click"
                    AutomationProperties.AutomationId="BtnStyleWin10"
                    AutomationProperties.Name="Windows 10"
                    ToolTipService.ToolTip="{x:Bind local:Loc.T('Square window corner and square controls.')}">
              <StackPanel Style="{StaticResource ModeTileStackStyle}">
                <TextBlock Text="Windows 10" Style="{x:Bind local:Converters.BoolToStyle(IsWin10StyleSelected, 'ModeTileLabelSelectedStyle', 'ModeTileLabelStyle'), Mode=OneWay}"/>
                <TextBlock Text="{x:Bind local:Loc.T('Square')}" Style="{StaticResource ThemeTileCaptionStyle}"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- ═══ MATERIAL: unsupported entries are greyed, never hidden.
               Label line + full-width control line: the material names and the accent
               options do not fit a 132 DIP control column next to a label. ═══ -->
          <Grid ColumnSpacing="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Material')}"
                       Style="{StaticResource ThemeLabelStyle}"/>
            <FontIcon Grid.Column="1"
                      Style="{StaticResource ThemeHelpGlyphStyle}"
                      ToolTipService.ToolTip="{x:Bind local:Loc.T('The backdrop behind the window. Mica and acrylic need a supported GPU driver; unsupported entries are greyed out and Performix falls back to a solid colour.')}"/>
          </Grid>

          <ComboBox x:Name="CmbMaterial"
                    Style="{StaticResource ThemeComboStyle}"
                    Margin="0,6,0,0"
                    SelectionChanged="Material_SelectionChanged"
                    AutomationProperties.AutomationId="CmbMaterial"
                    AutomationProperties.Name="{x:Bind local:Loc.T('Material')}"
                    AutomationProperties.HelpText="{x:Bind local:Loc.T('The backdrop behind the window. Mica and acrylic need a supported GPU driver; unsupported entries are greyed out and Performix falls back to a solid colour.')}">
            <ComboBoxItem x:Name="MaterialMicaItem" Content="{x:Bind local:Loc.T('Mica')}" Tag="Mica"/>
            <ComboBoxItem x:Name="MaterialAcrylicItem" Content="{x:Bind local:Loc.T('Acrylic')}" Tag="Acrylic"/>
            <ComboBoxItem x:Name="MaterialSolidItem" Content="{x:Bind local:Loc.T('Solid')}" Tag="Solid"/>
          </ComboBox>

          <TextBlock x:Name="TxtMaterialHint"
                     Style="{StaticResource ThemeHintStyle}"
                     Visibility="Collapsed"
                     Margin="0,4,0,0"
                     AutomationProperties.AutomationId="TxtMaterialHint"
                     AutomationProperties.LiveSetting="Polite"/>

          <!-- ═══ ACCENT COLOUR ═══ -->
          <Grid ColumnSpacing="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Accent colour')}"
                       Style="{StaticResource ThemeLabelStyle}"/>
            <FontIcon Grid.Column="1"
                      Style="{StaticResource ThemeHelpGlyphStyle}"
                      ToolTipService.ToolTip="{x:Bind local:Loc.T('Used for selected tiles, switches, sliders and the primary button. Follow Windows or pick one of the preset colours.')}"/>
          </Grid>

          <Grid ColumnSpacing="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

              <ComboBox x:Name="CmbAccent" Grid.Column="0"
                        Style="{StaticResource ThemeComboStyle}"
                        SelectionChanged="Accent_SelectionChanged"
                        AutomationProperties.AutomationId="CmbAccent"
                        AutomationProperties.Name="{x:Bind local:Loc.T('Accent colour')}">
                <ComboBoxItem Content="{x:Bind local:Loc.T('Follow system')}" Tag="System"/>
                <!-- UX review item 5: a colour name, with the hex kept in parentheses (the
                     tooltip repeats it). "Fixed #3B82F6" told a user nothing. -->
                <ComboBoxItem Content="{x:Bind local:Loc.T('Blue (#3B82F6)')}" Tag="Fixed"
                              ToolTipService.ToolTip="#3B82F6"/>
                <ComboBoxItem Content="{x:Bind local:Loc.T('Custom')}" Tag="Custom"/>
              </ComboBox>

              <!-- UX review item 6: the 28 DIP swatch looked like a colour sample, not a button.
                   A pencil badge in its bottom-right corner marks it as the way into the full
                   picker; selecting "Custom" in the combo opens the same flyout by itself, so the
                   palette is reachable without discovering this button at all. -->
              <Button x:Name="BtnAccentSwatch" Grid.Column="1"
                      Height="28" Width="28" Padding="0"
                      CornerRadius="{ThemeResource AppControlCornerRadius}"
                      UseSystemFocusVisuals="False"
                      Background="{StaticResource SectionBgBrush}"
                      BorderBrush="{StaticResource BorderStrongBrush}"
                      BorderThickness="1"
                      AutomationProperties.AutomationId="BtnAccentSwatch"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Accent colour')}"
                      ToolTipService.ToolTip="{x:Bind local:Loc.T('Open the colour palette.')}">
                <Grid>
                  <Border x:Name="AccentSwatchFill" Width="14" Height="14"
                          CornerRadius="{ThemeResource AppControlCornerRadius}"
                          Background="{StaticResource AccentBrush}"/>
                  <Border Width="14" Height="14"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          CornerRadius="7"
                          Background="{StaticResource WindowBgBrush}"
                          BorderBrush="{StaticResource BorderStrongBrush}"
                          BorderThickness="1">
                    <FontIcon Glyph="&#xE70F;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="11"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"/>
                  </Border>
                </Grid>
                <Button.Flyout>
                  <Flyout x:Name="AccentFlyout" Placement="Top" Closed="AccentFlyout_Closed">
                    <!-- Real colour picking: the ColorSpectrum primitive 160 DIP (verified size;
                         the ColorPicker control clips it at 160 because of its 256 DIP minimum).
                         Shape is an enum property spelled Shape="Ring". The eight swatches stay
                         as one-click shortcuts, and the TextBox edits the same #RRGGBB value. -->
                    <StackPanel Spacing="8">
                      <TextBlock x:Name="TxtAccentPickerTitle" FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                      <primitives:ColorSpectrum x:Name="AccentSpectrum"
                                                Width="160" Height="160"
                                                Shape="Ring"
                                                HorizontalAlignment="Left"
                                                ColorChanged="AccentSpectrum_ColorChanged"
                                                AutomationProperties.AutomationId="CtlAccentSpectrum"/>
                      <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#3B82F6" Tag="#3B82F6" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentBlue"/>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#8B5CF6" Tag="#8B5CF6" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentViolet"/>
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#EC4899" Tag="#EC4899" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentPink"/>
                        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#EF4444" Tag="#EF4444" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentRed"/>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#F59E0B" Tag="#F59E0B" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentAmber"/>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#22C55E" Tag="#22C55E" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentGreen"/>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#14B8A6" Tag="#14B8A6" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentTeal"/>
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource ThemeSwatchButtonStyle}"
                                Background="#64748B" Tag="#64748B" Click="PresetAccent_Click"
                                AutomationProperties.AutomationId="BtnAccentSlate"/>
                      </Grid>
                      <TextBox x:Name="AccentHexBox" Width="96" Height="30" MaxLength="7"
                               FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="SemiBold"
                               TextAlignment="Center" PlaceholderText="#3B82F6"
                               HorizontalAlignment="Left"
                               TextChanged="AccentHexBox_TextChanged"
                               LostFocus="AccentHexBox_LostFocus"
                               AutomationProperties.AutomationId="TxtAccentHexInput"
                               AutomationProperties.Name="{x:Bind local:Loc.T('Accent colour')}"/>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ CARD 2 · INTERFACE (the four panel-row switches) ═══ -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="0">

          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind local:Loc.T('Interface')}"
                       Style="{StaticResource SectionTitleStyle}"/>
            <FontIcon Grid.Column="1"
                      Style="{StaticResource ThemeHelpGlyphStyle}"
                      ToolTipService.ToolTip="{x:Bind local:Loc.T('Rows of the expanded panel. Each switch hides its row immediately and is remembered.')}"/>
          </Grid>

          <!-- Status bar: the read-only telemetry line of the expanded panel. -->
          <Grid Style="{StaticResource SettingRowStyle}" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind local:Loc.T('Status bar')}"
                         Style="{StaticResource ThemeLabelStyle}"/>
            </StackPanel>
            <ToggleSwitch x:Name="ChkUiStatusBar" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="UiStatusBar_Toggled"
                          AutomationProperties.AutomationId="ChkUiStatusBar"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Status bar')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('The read-only CPU / GPU telemetry row.')}"/>
          </Grid>

          <!-- Which fields that line prints. Names only (UI-DESIGN-RULES §7): the indentation
               says they belong to the row above, and the row's own switch says whether the row
               exists at all. Two columns keep the four names on two lines at 320 DIP; a single
               row of four would wrap mid-name. -->
          <Grid Margin="12,4,0,0" ColumnSpacing="{StaticResource GapTight}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox x:Name="ChkStatusTemperature" Grid.Row="0" Grid.Column="0"
                      Style="{StaticResource StatusFieldCheckStyle}"
                      Tag="StatusBarTemperature"
                      Content="{x:Bind local:Loc.T('Temperature')}"
                      Checked="StatusField_Changed" Unchecked="StatusField_Changed"
                      AutomationProperties.AutomationId="ChkStatusTemperature"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Temperature')}"/>

            <CheckBox x:Name="ChkStatusUsage" Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource StatusFieldCheckStyle}"
                      Tag="StatusBarUsage"
                      Content="{x:Bind local:Loc.T('Usage')}"
                      Checked="StatusField_Changed" Unchecked="StatusField_Changed"
                      AutomationProperties.AutomationId="ChkStatusUsage"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Usage')}"/>

            <CheckBox x:Name="ChkStatusFrequency" Grid.Row="1" Grid.Column="0"
                      Style="{StaticResource StatusFieldCheckStyle}"
                      Tag="StatusBarFrequency"
                      Content="{x:Bind local:Loc.T('Frequency')}"
                      Checked="StatusField_Changed" Unchecked="StatusField_Changed"
                      AutomationProperties.AutomationId="ChkStatusFrequency"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Frequency')}"/>

            <CheckBox x:Name="ChkStatusFan" Grid.Row="1" Grid.Column="1"
                      Style="{StaticResource StatusFieldCheckStyle}"
                      Tag="StatusBarFan"
                      Content="{x:Bind local:Loc.T('Fan speed')}"
                      Checked="StatusField_Changed" Unchecked="StatusField_Changed"
                      AutomationProperties.AutomationId="ChkStatusFan"
                      AutomationProperties.Name="{x:Bind local:Loc.T('Fan speed')}"/>
          </Grid>

          <!-- GPU bar: GPU mode header + the four tiles. -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind local:Loc.T('GPU bar')}"
                         Style="{StaticResource ThemeLabelStyle}"/>
            </StackPanel>
            <ToggleSwitch x:Name="ChkUiGpuBar" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="UiGpuBar_Toggled"
                          AutomationProperties.AutomationId="ChkUiGpuBar"
                          AutomationProperties.Name="{x:Bind local:Loc.T('GPU bar')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('The GPU mode header and the four GPU tiles.')}"/>
          </Grid>

          <!-- Refresh rate bar: auto-refresh chip + Hz picker + current display mode. -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind local:Loc.T('Refresh rate bar')}"
                         Style="{StaticResource ThemeLabelStyle}"/>
            </StackPanel>
            <ToggleSwitch x:Name="ChkUiRefreshRateBar" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="UiRefreshRateBar_Toggled"
                          AutomationProperties.AutomationId="ChkUiRefreshRateBar"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Refresh rate bar')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('The auto-refresh chip, the refresh-rate picker and the current display mode.')}"/>
          </Grid>

          <!-- Widget bar: the four page entries. Settings is NOT part of it. -->
          <Grid Style="{StaticResource SettingRowStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind local:Loc.T('Widget bar')}"
                         Style="{StaticResource ThemeLabelStyle}"/>
            </StackPanel>
            <ToggleSwitch x:Name="ChkUiWidgetBar" Grid.Column="1"
                          Style="{StaticResource SettingSwitchStyle}"
                          OnContent="{x:Bind local:Loc.T('On')}"
                          OffContent="{x:Bind local:Loc.T('Off')}"
                          Toggled="UiWidgetBar_Toggled"
                          AutomationProperties.AutomationId="ChkUiWidgetBar"
                          AutomationProperties.Name="{x:Bind local:Loc.T('Widget bar')}"
                          AutomationProperties.HelpText="{x:Bind local:Loc.T('The lighting, HUD, fans and tuning entries. The Settings entry always stays.')}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
