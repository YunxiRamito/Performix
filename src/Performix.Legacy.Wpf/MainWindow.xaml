<?xml version="1.0" encoding="utf-8"?>
<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:PreySense.Frontend.ViewModels" xmlns:controls="clr-namespace:PreySense.Frontend.Controls" xmlns:local="clr-namespace:PreySense.Frontend" Title="Performix" Icon="appicon.ico" Width="500" SizeToContent="Height" WindowStartupLocation="CenterScreen" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}" ResizeMode="NoResize" ShowInTaskbar="False" AutomationProperties.AutomationId="MainWindow">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Border Style="{DynamicResource AppWindowShellStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:WindowTitleBar xmlns:services="clr-namespace:PreySense.Frontend.Services" Grid.Row="0" Subtitle="{x:Static services:UpdateCheckService.DisplayVersion}">
        <controls:WindowTitleBar.Actions>
          <Button AutomationProperties.AutomationId="BtnSettings" AutomationProperties.Name="Settings" Style="{StaticResource TitleBarButtonStyle}" Click="SettingsButton_Click">
            <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Settings}" Size="14" />
          </Button>
        </controls:WindowTitleBar.Actions>
      </controls:WindowTitleBar>
      <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{DynamicResource MainSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.PerformanceMode}" Size="14" Margin="0,0,6,0" />
                <TextBlock Text="Performance Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Run Text="CPU"/><Run Text=": "/>
                <Run Text="{Binding CpuTemperatureText, Mode=OneWay}"/>
                <Run Text=" • "/>
                <Run Text="{Binding CpuFanText, Mode=OneWay}"/>
              </TextBlock>
            </Grid>
            <UniformGrid Columns="5" Rows="1" Margin="0,2,0,2">
              <Button AutomationProperties.AutomationId="BtnModeEco" AutomationProperties.Name="Eco" Command="{Binding SetModeCommand}" CommandParameter="6">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsEcoActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeEcoBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Eco}" Size="17" Margin="0,0,0,5" />
                  <TextBlock FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" Text="Eco" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeQuiet" AutomationProperties.Name="Quiet" Command="{Binding SetModeCommand}" CommandParameter="0">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsQuietActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeQuietBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Quiet}" Size="17" Margin="0,0,0,5" />
                  <TextBlock Text="Quiet" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeBalanced" AutomationProperties.Name="Balanced" CommandParameter="1" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBalancedActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeBalancedBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Balanced}" Size="17" Margin="0,0,0,5" />
                  <TextBlock Text="Balanced" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModePerformance" AutomationProperties.Name="Performance" CommandParameter="4" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsPerformActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Performance}" Size="17" Margin="0,0,0,5" />
                  <TextBlock Text="Performance" FontSize="{DynamicResource FontSizeTile}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeTurbo" AutomationProperties.Name="Turbo" CommandParameter="5" Command="{Binding SetModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsTurboActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeTurboBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Turbo}" Size="17" Margin="0,0,0,5" />
                  <TextBlock Text="Turbo" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{DynamicResource MainSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Gpu}" Size="14" Margin="0,0,6,0" />
                <TextBlock Text="GPU Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Run Text="GPU"/><Run Text=": "/>
                <Run Text="{Binding GpuTemperatureText, Mode=OneWay}"/>
                <Run Text=" • "/>
                <Run Text="{Binding GpuFanText, Mode=OneWay}"/>
              </TextBlock>
            </Grid>
            <UniformGrid Columns="{Binding GpuModeTileColumns}" Rows="1" Margin="0,2,0,2">
              <Button Height="62" Margin="3" AutomationProperties.AutomationId="BtnGpuAuto" AutomationProperties.Name="Auto" CommandParameter="1" Command="{Binding SetGpuMuxModeCommand}">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAutoActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.AutoGpu}" Size="20" Margin="0,0,0,2" />
                  <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" CommandParameter="0" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowDdsGpuTiles, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="BtnGpuHybrid" AutomationProperties.Name="Hybrid">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.HybridGpu}" Size="20" Margin="0,0,0,2" />
                  <TextBlock Text="Hybrid" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" CommandParameter="2" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowDdsGpuTiles, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="BtnGpuAdvancedOptimus" AutomationProperties.Name="Advanced Optimus">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAdvancedOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.AdvancedGpu}" Size="20" Margin="0,0,0,2" />
                  <TextBlock Text="Advanced Optimus" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Height="62" Margin="3" Command="{Binding SetBiosDiscreteGpuCommand}" AutomationProperties.AutomationId="BtnGpuDiscrete" AutomationProperties.Name="dGPU Only">
                <Button.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBiosDiscreteGpuActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.DiscreteGpu}" Size="20" Margin="0,0,0,2" />
                  <TextBlock Text="dGPU Only" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="0">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Display}" Size="14" Margin="0,0,6,0" />
                <TextBlock Text="Display" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ActiveGpuDisplayMode, Mode=OneWay}"
                         Style="{StaticResource OriginalStatusTextStyle}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Height="38" Padding="12,4" HorizontalAlignment="Stretch" Margin="3,0,6,0" Command="{Binding ToggleAutoRefreshRateCommand}" AutomationProperties.AutomationId="BtnAutoRefreshRate" AutomationProperties.Name="Auto refresh rate">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsAutoRefreshRateEnabled}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="{DynamicResource SelectedControlBorderThickness}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" />
              </Button>

              <ComboBox Grid.Column="1" Height="38" Margin="0,0,3,0"
                        AutomationProperties.AutomationId="CmbRefreshRate"
                        AutomationProperties.Name="Refresh rate"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="12,4"
                        BorderThickness="0"
                        FontSize="{DynamicResource FontSizeTile}"
                        ItemsSource="{Binding AvailableRefreshRates}"
                        SelectedItem="{Binding SelectedRefreshRateOption, Mode=TwoWay}"/>
            </Grid>
          </StackPanel>
        </Border>
        <Separator HorizontalAlignment="Center" Width="100" Margin="0,13,0,5"/>
      </StackPanel>
      <Grid Grid.Row="2" Margin="14,2,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="34"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavLighting" Style="{StaticResource WindowFooterButtonStyle}" Click="KeyboardButton_Click" AutomationProperties.Name="Lighting">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Lighting}" Size="14" Margin="0,0,5,0" />
              <TextBlock Text="Lighting" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavMetrics" Style="{StaticResource WindowFooterButtonStyle}" Click="MetricsButton_Click" AutomationProperties.Name="Overlay">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Overlay}" Size="14" Margin="0,0,5,0" />
              <TextBlock Text="Overlay" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavFans" Style="{StaticResource WindowFooterButtonStyle}" Click="FansButton_Click" AutomationProperties.Name="Fans">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Fans}" Size="14" Margin="0,0,5,0" />
              <TextBlock Text="Fans" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavMode" Style="{StaticResource WindowFooterButtonStyle}" Click="ModeSettingsButton_Click" AutomationProperties.Name="Tuning">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Tuning}" Size="14" Margin="0,0,5,0" />
              <TextBlock Text="Tuning" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavQuit" Style="{StaticResource WindowFooterButtonStyle}" Click="QuitButton_Click" AutomationProperties.Name="Quit">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Close}" Size="14" Margin="0,0,5,0" />
              <TextBlock Text="Quit" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
    </Grid>
  </Border>
</Window>
