<UserControl x:Class="PreySense.Frontend.Controls.SettingSwitchRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
             x:Name="RootSwitchRow">
    <Grid HorizontalAlignment="Stretch" Margin="{DynamicResource StandardRowMargin}"
          ToolTipService.ToolTip="{Binding HelpText, ElementName=RootSwitchRow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title, ElementName=RootSwitchRow}"
                           Style="{DynamicResource SettingLabelStyle}"
                           VerticalAlignment="Center" />
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Info}" Size="11" Margin="6,0,0,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}">
                    <controls:FluentIcon.Style>
                        <Style TargetType="controls:FluentIcon">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HelpText, ElementName=RootSwitchRow}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HelpText, ElementName=RootSwitchRow}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:FluentIcon.Style>
                </controls:FluentIcon>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle, ElementName=RootSwitchRow}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=RootSwitchRow}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Subtitle, ElementName=RootSwitchRow}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <controls:RectangularSwitch x:Name="InnerSwitch" Grid.Column="1" VerticalAlignment="Center"
                                    MinWidth="{Binding SwitchWidth, ElementName=RootSwitchRow}"
                                    IsChecked="{Binding IsChecked, ElementName=RootSwitchRow, Mode=TwoWay}"
                                    OnText="{Binding OnText, ElementName=RootSwitchRow}"
                                    OffText="{Binding OffText, ElementName=RootSwitchRow}"
                                    Command="{Binding Command, ElementName=RootSwitchRow}"
                                    CommandParameter="{Binding CommandParameter, ElementName=RootSwitchRow}"
                                    AutomationProperties.AutomationId="{Binding SwitchAutomationId, ElementName=RootSwitchRow}"
                                    AutomationProperties.Name="{Binding Title, ElementName=RootSwitchRow}" />
    </Grid>
</UserControl>
