<UserControl x:Class="PreySense.Frontend.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
             x:Name="Root"
             Background="Transparent"
             HorizontalAlignment="Stretch">
    <Grid x:Name="BarGrid" Style="{DynamicResource WindowTitleBarStyle}"
          MouseLeftButtonDown="TitleBar_MouseDown"
          MouseRightButtonUp="TitleBar_MouseRightButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="pack://application:,,,/appicon.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Performix" Style="{DynamicResource WindowTitleTextStyle}"/>
            <TextBlock x:Name="TitleText" Style="{DynamicResource WindowSubtitleTextStyle}"/>
            <TextBlock x:Name="SubtitleText" Style="{DynamicResource WindowSubtitleTextStyle}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <ContentPresenter Content="{Binding Actions, ElementName=Root}"/>
            <Button x:Name="MinimizeButton"
                    AutomationProperties.AutomationId="BtnTitleBarMinimize"
                    AutomationProperties.Name="Minimize"
                    Style="{DynamicResource TitleBarButtonStyle}"
                    Click="MinimizeButton_Click">
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Minimize}" Size="10" />
            </Button>
            <Button x:Name="MaximizeButton"
                    AutomationProperties.AutomationId="BtnTitleBarMaximize"
                    AutomationProperties.Name="Maximize"
                    Style="{DynamicResource TitleBarButtonStyle}"
                    Click="MaximizeButton_Click">
                <controls:FluentIcon x:Name="MaximizeGlyph" Glyph="{x:Static controls:FluentGlyphs.Maximize}" Size="10" />
            </Button>
            <Button x:Name="CloseButton"
                    AutomationProperties.AutomationId="BtnTitleBarClose"
                    AutomationProperties.Name="Close"
                    Style="{DynamicResource TitleBarCloseButtonStyle}"
                    Click="CloseButton_Click">
                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Close}" Size="10" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
