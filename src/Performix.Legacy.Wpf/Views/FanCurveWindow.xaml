<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.FanCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        Title="Performix • Fans" Width="620" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}" AutomationProperties.AutomationId="FanCurveWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:WindowTitleBar Grid.Row="0" Title="Fans"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource WindowContentMargin}" MaxWidth="680" HorizontalAlignment="Stretch">
                <controls:SettingDropdownRow x:Name="ProfileRow" Title="Profile Mode"
                    AutomationProperties.AutomationId="CmbFanProfileMode" ComboBoxAutomationId="CmbFanProfileMode"
                    ItemsSource="{Binding FanCurveModeNames}" DropdownWidth="160" Margin="0,0,0,4"/>
                <TextBlock x:Name="EditingHint" Margin="0,0,0,10" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="ModeHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="FanFloorHint" TextWrapping="Wrap" Margin="0,0,0,8"
                           FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Note: 0% duty still runs the EC fan floor at about 3500 RPM; the fan cannot stop."/>
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <CheckBox x:Name="PredictiveOption" Content="Load prediction" Checked="SchedulerOption_Changed" Unchecked="SchedulerOption_Changed"
                              AutomationProperties.AutomationId="ChkLoadPrediction" AutomationProperties.Name="Load prediction"/>
                    <CheckBox x:Name="ClosedLoopOption" Content="Closed-loop RPM trim" Checked="SchedulerOption_Changed" Unchecked="SchedulerOption_Changed"
                              AutomationProperties.AutomationId="ChkClosedLoopTrim" AutomationProperties.Name="Closed-loop RPM trim"/>
                </UniformGrid>
                <controls:SettingValueRow x:Name="PredictiveLeadRow" Title="Prediction lead" Unit="&#xB0;C" Minimum="0" Maximum="15"
                    AllowEmpty="True" ValueCommitted="PredictiveLead_Committed" Margin="0,0,0,4"
                    AutomationProperties.AutomationId="TxtPredictionLead"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Live RPM" Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveRpmText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeBody}" Text="N/A"
                               AutomationProperties.AutomationId="TxtLiveRpm"/>
                </Grid>
                <TextBlock Text="Per-process fan curves (one per line: app.exe=Balanced)" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="BindingsBox" AcceptsReturn="True" Height="48" Margin="0,4,0,10"
                         VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource FontSizeBody}"
                         AutomationProperties.AutomationId="TxtProcessFanBindings"/>
                <UniformGrid Columns="4" Margin="{StaticResource StandardSectionMargin}">
                    <RadioButton x:Name="AutoOption" Content="Auto" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"
                                 AutomationProperties.AutomationId="RdoFanAuto" AutomationProperties.Name="Auto"/>
                    <RadioButton x:Name="MaxOption" Content="Max" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"
                                 AutomationProperties.AutomationId="RdoFanMax" AutomationProperties.Name="Max"/>
                    <RadioButton x:Name="CustomOption" Content="Custom" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"
                                 AutomationProperties.AutomationId="RdoFanCustom" AutomationProperties.Name="Custom"/>
                    <RadioButton x:Name="CurveOption" Content="Curve" GroupName="FanControl" Style="{StaticResource SegmentedTabRadioStyle}" Checked="FanMode_Changed"
                                 AutomationProperties.AutomationId="RdoFanCurve" AutomationProperties.Name="Curve"/>
                </UniformGrid>
                <controls:LabeledTabSwitcher x:Name="FanTabs" Margin="{StaticResource StandardSectionMargin}"
                    AutomationProperties.AutomationId="TabFanTarget"
                    LeftText="CPU Fan" RightText="GPU Fan"
                    LeftGlyph="{x:Static controls:FluentGlyphs.Cpu}" RightGlyph="{x:Static controls:FluentGlyphs.Gpu}"
                    SelectionChanged="FanTab_Changed"/>
                <StackPanel x:Name="CurveEditor">
                    <controls:SettingSliderRow x:Name="DelayRow" Title="Fan Control Delay"
                        AutomationProperties.AutomationId="SldFanControlDelay" SliderAutomationId="SldFanControlDelay"
                        Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" TickFrequency="1"
                        IsSnapToTickEnabled="True" Value="0" ValueText="0 s"
                        ValueChanged="DelayRow_ValueChanged" Margin="0,0,0,8"/>
                    <controls:WpfFanCurveControl x:Name="Curve" Height="260" AutomationProperties.AutomationId="CtlFanCurvePlot"/>
                    <controls:SettingValueRow x:Name="RowTemp" Title="Temp" Minimum="40" Maximum="100" Unit="&#xB0;C" ValueCommitted="StageField_Committed" Margin="0,8,0,0"
                        AutomationProperties.AutomationId="TxtCurvePointTemp"/>
                    <controls:SettingValueRow x:Name="RowDuty" Title="Duty" Minimum="0" Maximum="100" Unit="%" ValueCommitted="StageField_Committed"
                        AutomationProperties.AutomationId="TxtCurvePointDuty"/>
                    <controls:SettingValueRow x:Name="RowRpm" Title="RPM" Minimum="0" Maximum="6400" Unit="RPM" ValueCommitted="StageField_Committed"
                        AutomationProperties.AutomationId="TxtCurvePointRpm"/>
                </StackPanel>
                <TextBlock x:Name="OperationError" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel x:Name="CurveEditorPanel" Visibility="Collapsed">
                    <TextBlock Text="CPU Curve (drag points, 20-110 C, 0-100 %)" TextWrapping="Wrap" Margin="0,8,0,2"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" CornerRadius="8" Margin="0,0,0,8">
                        <Canvas x:Name="CpuCurveCanvas" Height="180" Background="Transparent" ClipToBounds="True"
                                AutomationProperties.AutomationId="CanvasCpuFanCurve"
                                MouseLeftButtonDown="CurveCanvas_MouseDown" MouseMove="CurveCanvas_MouseMove"
                                MouseLeftButtonUp="CurveCanvas_MouseUp" Tag="cpu"/>
                    </Border>
                    <TextBlock Text="GPU Curve (drag points, 20-110 C, 0-100 %)" TextWrapping="Wrap" Margin="0,0,0,2"
                               FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" CornerRadius="8" Margin="0,0,0,8">
                        <Canvas x:Name="GpuCurveCanvas" Height="180" Background="Transparent" ClipToBounds="True"
                                AutomationProperties.AutomationId="CanvasGpuFanCurve"
                                MouseLeftButtonDown="CurveCanvas_MouseDown" MouseMove="CurveCanvas_MouseMove"
                                MouseLeftButtonUp="CurveCanvas_MouseUp" Tag="gpu"/>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <CheckBox x:Name="ClampOption" Content="Clamp to Grid (5 %)" Margin="0,0,6,0"
                                  AutomationProperties.AutomationId="ChkClampToGrid" AutomationProperties.Name="Clamp to Grid (5 %)"/>
                        <CheckBox x:Name="AutoApplyOption" Content="Auto Apply"
                                  AutomationProperties.AutomationId="ChkAutoApply" AutomationProperties.Name="Auto Apply"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="Apply" Click="Apply_Click" Style="{StaticResource WindowFooterButtonStyle}" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="BtnApplyInlineFanCurve" AutomationProperties.Name="Apply"/>
                        <Button Content="Reset" Click="Reset_Click" Style="{StaticResource WindowFooterButtonStyle}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="BtnResetInlineFanCurve" AutomationProperties.Name="Reset"/>
                    </UniformGrid>
                    <Expander Header="Precise Input" IsExpanded="False" AutomationProperties.AutomationId="ExpPreciseInput" AutomationProperties.Name="Precise Input">
                        <StackPanel>
                            <TextBlock Text="Curve points (temp=duty, one per line, exactly 8)" TextWrapping="Wrap" Margin="0,2,0,2"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="CurvePointsBox" AcceptsReturn="True" Height="96" Margin="0,0,0,6"
                                     VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource FontSizeBody}"
                                     AutomationProperties.AutomationId="TxtCurvePoints"/>
                            <controls:SettingValueRow x:Name="CurveRampUpRow" Title="Ramp up (%/s)" AllowEmpty="True"
                                Minimum="1" Maximum="50" Unit="%/s" ValueCommitted="CurveField_Committed" Margin="0,0,0,4"
                                AutomationProperties.AutomationId="TxtCurveRampUp"/>
                            <controls:SettingValueRow x:Name="CurveRampDownRow" Title="Ramp down (%/s)" AllowEmpty="True"
                                Minimum="1" Maximum="50" Unit="%/s" ValueCommitted="CurveField_Committed" Margin="0,0,0,4"
                                AutomationProperties.AutomationId="TxtCurveRampDown"/>
                            <controls:SettingValueRow x:Name="CurveHysteresisRow" Title="Hysteresis" AllowEmpty="True"
                                Minimum="0" Maximum="5" Unit="&#xB0;C" ValueCommitted="CurveField_Committed" Margin="0,0,0,4"
                                AutomationProperties.AutomationId="TxtCurveHysteresis"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            <UniformGrid x:Name="FooterPanel" Grid.Row="2" Columns="3" Style="{StaticResource WindowFooterPanelStyle}">
                <Button Content="Reset" Click="Reset_Click" Style="{StaticResource WindowFooterButtonStyle}"
                        AutomationProperties.AutomationId="BtnResetFanCurve" AutomationProperties.Name="Reset"/>
                <Button Content="Apply" Click="Apply_Click" Style="{StaticResource WindowFooterButtonStyle}"
                        AutomationProperties.AutomationId="BtnApplyFanCurve" AutomationProperties.Name="Apply"/>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource WindowFooterButtonStyle}"
                        AutomationProperties.AutomationId="BtnSaveFanCurve" AutomationProperties.Name="Save"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
