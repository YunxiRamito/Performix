<Window x:Class="PreySense.Frontend.Views.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Performix • Info"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Border x:Name="Shell"
            CornerRadius="12"
            Background="{DynamicResource ToastSurfaceBrush}"
            BorderBrush="{DynamicResource BorderMainBrush}"
            BorderThickness="1"
            Padding="18,12,18,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 状态指示：彩色圆点（Working 时换成转圈） -->
                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot"
                             Width="10" Height="10"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" />
                    <Ellipse x:Name="Ring"
                             Width="26" Height="26"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="1.5 2.5"
                             Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="RingRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="{DynamicResource FontSizeControl}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               MaxHeight="40" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,3,0,0"
                               FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="64"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Bar"
                         Grid.Row="1"
                         Margin="52,10,0,0"
                         Height="3"
                         Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource ControlTrackBrush}"
                         BorderThickness="0" />
        </Grid>
    </Border>
</Window>
