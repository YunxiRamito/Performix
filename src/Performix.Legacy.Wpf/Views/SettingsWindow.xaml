<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PreySense.Frontend.Controls"
        mc:Ignorable="d"
        Title="Performix • Settings"
        Width="500"
        Height="620"
        MinWidth="460"
        MinHeight="360"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="CanResize" AutomationProperties.AutomationId="SettingsWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource AppWindowShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="*"/>    <!-- Row 1: Settings Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <controls:WindowTitleBar Grid.Row="0" Title="Settings"/>

            <!-- Content Area with consistent margins and spacing -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{StaticResource WindowContentMargin}" MaxWidth="640" HorizontalAlignment="Stretch">

                    <!-- Section: General -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Settings}" Size="14" Margin="0,0,6,0"/>
                                <TextBlock Text="General" Style="{StaticResource OriginalSectionTitleStyle}"/>
                            </StackPanel>

                            <controls:SettingDropdownRow x:Name="LanguageSelector"
                                                         Title="Language"
                                                         DropdownWidth="170"
                                                         ComboBoxAutomationId="CmbLanguage"
                                                         AutomationProperties.AutomationId="CmbLanguage"
                                                         HelpText="Applied immediately and saved to preysense.json. Missing translations fall back to English."
                                                         SelectionChanged="LanguageSelector_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="Simplified Chinese" Tag="zh-CN"/>
                                <ComboBoxItem Content="Hindi" Tag="hi-IN"/>
                                <ComboBoxItem Content="Spanish" Tag="es-ES"/>
                                <ComboBoxItem Content="French" Tag="fr-FR"/>
                            </controls:SettingDropdownRow>

                            <controls:SettingDropdownRow x:Name="ThemeSelector" Title="Theme" DropdownWidth="130"
                                                         ComboBoxAutomationId="CmbTheme"
                                                         AutomationProperties.AutomationId="CmbTheme"
                                                         HelpText="Dark and Light use solid surfaces; Glass adds the Windows acrylic material to windows and menus."
                                                         SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Glass"/>
                            </controls:SettingDropdownRow>

                            <controls:SettingSwitchRow Title="Run on Startup"
                                                       SwitchAutomationId="ChkRunOnStartup"
                                                       AutomationProperties.AutomationId="ChkRunOnStartup"
                                                       HelpText="Registers an elevated scheduled task so Windows starts Performix with fan curves and lighting restored."
                                                       IsEnabled="{Binding CanChangeRunOnStartup}"
                                                       IsChecked="{Binding IsRunOnStartupEnabled, Mode=TwoWay}"
                                                       Command="{Binding ToggleRunOnStartupCommand}"/>

                            <controls:SettingSwitchRow Title="Acer Services"
                                                       SwitchAutomationId="ChkAcerServices"
                                                       AutomationProperties.AutomationId="ChkAcerServices"
                                                       HelpText="Stops and disables Acer OEM background services to free memory. The official Predator Sense app stops working until you re-enable them."
                                                       IsChecked="{Binding IsAcerServicesEnabled, Mode=OneWay}"
                                                       Command="{Binding ToggleAcerServicesDebloaterCommand}"
                                                       OnText="Enabled"
                                                       OffText="Disabled"
                                                       SwitchWidth="120"/>

                            <controls:SettingSwitchRow Title="Battery Limit"
                                                       SwitchAutomationId="ChkBatteryLimit"
                                                       AutomationProperties.AutomationId="ChkBatteryLimit"
                                                       HelpText="Caps charging at 80% to slow battery wear. Turned off the battery charges to 100%."
                                                       IsChecked="{Binding IsBatteryLimitEnabled, Mode=OneWay}"
                                                       OnText="80%"
                                                       OffText="100%"
                                                       SwitchWidth="92"
                                                       Command="{Binding ToggleBatteryLimitCommand}"/>

                            <controls:SettingSliderRow x:Name="UsbChargingSlider" Title="USB Power-Off Charging"
                                                       SliderAutomationId="SldUsbCharging"
                                                       AutomationProperties.AutomationId="SldUsbCharging"
                                                       HelpText="Charges devices from the supported USB port while the laptop is off. Stops at the selected laptop battery level and uses battery power."
                                                       Minimum="0" Maximum="30" SmallChange="10" LargeChange="10"
                                                       TickFrequency="10" IsSnapToTickEnabled="True"
                                                       Value="{Binding UsbChargingCutoffPercent, Mode=OneWay}"
                                                       ValueChanged="UsbCharging_ValueChanged"
                                                       PreviewMouseLeftButtonUp="UsbCharging_MouseReleased"
                                                       LostMouseCapture="UsbCharging_MouseCaptureLost"
                                                       PreviewKeyUp="UsbCharging_KeyReleased"
                                                       IsEnabled="{Binding CanChangeUsbCharging}"
                                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding UsbChargingStatus}" TextWrapping="Wrap" Margin="0,2,0,4"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsbChargingStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section: Power Profiles -->
                    <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Performance}" Size="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Power Profiles" Style="{StaticResource OriginalSectionTitleStyle}"/>
                                <controls:FluentIcon Glyph="{x:Static controls:FluentGlyphs.Info}" Size="12" Margin="6,0,0,0"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     ToolTip="The profile is applied automatically when the laptop switches between battery and AC power."/>
                            </StackPanel>
                            <controls:SettingDropdownRow Title="On Battery"
                                                         AutomationProperties.AutomationId="CmbBatteryPowerMode"
                                                         ComboBoxAutomationId="CmbBatteryPowerMode"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding BatteryPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="170"/>

                            <controls:SettingSwitchRow Title="Energy Saver on Battery"
                                                       SwitchAutomationId="ChkEnergySaverOnBattery"
                                                       AutomationProperties.AutomationId="ChkEnergySaverOnBattery"
                                                       HelpText="Turns on the Windows Energy Saver while the laptop runs from battery."
                                                       IsChecked="{Binding IsBatteryEnergySaverEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <controls:SettingDropdownRow Title="On AC"
                                                         AutomationProperties.AutomationId="CmbAcPowerMode"
                                                         ComboBoxAutomationId="CmbAcPowerMode"
                                                         ItemsSource="{Binding SourceProfileNames}"
                                                         SelectedIndex="{Binding AcPowerModeIndex, Mode=TwoWay}"
                                                         DropdownWidth="170"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
